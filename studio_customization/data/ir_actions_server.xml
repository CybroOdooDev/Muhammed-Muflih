  <record id="create_invoice_9f7e496d-e2d8-4ab4-98cf-6e72cfb15c51" model="ir.actions.server" context="{'studio': True}">
    <field name="binding_model_id" ref="repair_request_2836934e-e26c-4d06-9b49-ed55c7dfbbf6"/>
    <field name="code"><![CDATA[# Safely find the partner field using Odoo's safe_eval environment
partner_id = False
if 'x_studio_partner_id' in record._fields and record.x_studio_partner_id:
    partner_id = record.x_studio_partner_id.id
elif 'partner_id' in record._fields and record.partner_id:
    partner_id = record.partner_id.id
elif 'x_studio_contact' in record._fields and record.x_studio_contact:
    partner_id = record.x_studio_contact.id

action = {
    'name': 'Customer Invoice',
    'type': 'ir.actions.act_window',
    'res_model': 'account.move',
    'view_mode': 'form',
    'views': [(False, 'form')],
    'target': 'current',
    'context': {
        'default_move_type': 'out_invoice',
        'default_partner_id': partner_id,
    }
}]]></field>
    <field name="model_id" ref="repair_request_2836934e-e26c-4d06-9b49-ed55c7dfbbf6"/>
    <field name="state">code</field>
    <field name="name">create invoice</field>
  </record>
