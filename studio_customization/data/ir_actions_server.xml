    <field name="code"><![CDATA[for record in records:
    if not record.x_name or  record.x_name=='New':
        sequence_num=env['ir.sequence'].next_by_code('repair.request.sequence.code')or 'New'
        record.write({'x_name':sequence_num})]]></field>
    <field name="model_id" ref="repair_request_2836934e-e26c-4d06-9b49-ed55c7dfbbf6"/>
