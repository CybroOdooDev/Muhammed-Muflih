<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_mobile_service" model="ir.module.category">
    <field name="name">Mobile Service</field>
    <field name="description">User access level for Mobile Service application</field>
    <field name="sequence">20</field>
  </record>

  <record id="res_groups_privilege_mobile_service" model="res.groups.privilege">
    <field name="name">Mobile Service Access</field>
    <field name="category_id" ref="module_category_mobile_service"/>
  </record>

  <record id="group_mobile_service_technician" model="res.groups">
    <field name="name">Mobile Technician</field>
    <field name="privilege_id" ref="res_groups_privilege_mobile_service"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_mobile_service_manager" model="res.groups">
    <field name="name">Mobile Service Manager</field>
    <field name="privilege_id" ref="res_groups_privilege_mobile_service"/>
    <field name="implied_ids" eval="[(4, ref('group_mobile_service_technician'))]"/>
  </record>
</odoo>
