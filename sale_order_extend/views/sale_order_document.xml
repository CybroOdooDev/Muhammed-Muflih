<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_extend_saleorder_document"
              inherit_id="sale.report_saleorder_document">

        <!-- Font size + spacing fixes -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <style>
                .o_snail_mail .address,
                div.address.row {
                padding-top: 0 !important;
                margin-top: 0 !important;
                margin-bottom: 4px !important;
                }
                .header {
                margin-bottom: 0 !important;
                padding-bottom: 0 !important;
                }
                .o_snail_mail {
                padding-top: 0 !important;
                }
                .page {
                font-size: 12px !important; /* was 11px */
                }
                .page h2 {
                font-size: 19px !important; /* was 18px */
                }
                .o_main_table thead th {
                font-size: 11px !important; /* was 10px */
                }
                .o_main_table tbody td,
                .o_main_table tbody td span {
                font-size: 11.5px !important; /* was 10.5px */
                }
                .o_total_table td,
                .o_total_table td span,
                .o_total_table td strong {
                font-size: 11.5px !important; /* was 10.5px */
                }
            </style>
        </xpath>

        <!-- Warehouse -->
        <xpath expr="//div[@t-if='doc.date_order']" position="inside">
            <div t-if="doc.project_id">
                <strong>Warehouse</strong>
                <p class="m-0" t-field="doc.warehouse_id.name"/>
            </div>
        </xpath>

        <!-- Project Name -->
        <xpath expr="//div[@t-if='doc.user_id.name']" position="inside">
            <div t-if="doc.project_id">
                <strong>Project Name</strong>
                <p class="m-0" t-field="doc.project_id.name"/>
            </div>
        </xpath>

        <!-- Blank note-field guard -->
        <xpath expr="//div//div[@id='informations']" position="before">
            <p t-if="not is_html_empty(doc.note)" t-field="doc.note"
               name="order_note_extend"/>
        </xpath>

        <!-- Seq column header (leftmost) -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_seq" class="text-start" style="width:24px;">Seq</th>
        </xpath>

        <!-- Seq column value -->
        <xpath expr="//td[@name='td_product_name']" position="before">
            <td name="td_seq">
                <span t-esc="line_index + 1"/>
            </td>
        </xpath>

    </template>
</odoo>