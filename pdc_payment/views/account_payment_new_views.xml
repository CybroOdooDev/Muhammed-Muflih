<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_vendor_payment_form" model="ir.ui.view">
        <field name="name">account.payment.vendor.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_vendor_account_payment" invisible="1" readonly="1"/>
                <field name="vendor_account_id"
                       invisible="not is_vendor_account_payment"
                       required="is_vendor_account_payment"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//group[@name='group1']/field[@name='partner_id'][1]" position="attributes">
                <attribute name="invisible">is_vendor_account_payment or partner_type != 'customer'</attribute>
            </xpath>

            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="attributes">
                <attribute name="invisible">is_vendor_account_payment or partner_type != 'supplier'</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_tag']" position="attributes">
                <attribute name="invisible">is_vendor_account_payment</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_account_payment_vendor_account_search" model="ir.ui.view">
        <field name="name">account.payment.vendor.account.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Account Payments"
                        name="account_payment_filter"
                        domain="[('is_vendor_account_payment', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_vendor_account_payment" model="ir.actions.act_window">
        <field name="name">Account Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form,graph,activity</field>
        <field name="context">{
            'default_is_vendor_account_payment': True,
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'search_default_outbound_filter': 1,
            'search_default_account_payment_filter': 1,
            'default_move_journal_types': ('bank', 'cash'),
            'display_account_trust': True,
        }</field>
        <field name="view_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              Register a vendor account payment
            </p><p>
              Payments are used to register liquidity movements based on vendor account.
              You can process those payments by your own means or by using installed facilities.
            </p>
        </field>
    </record>

    <menuitem id="menu_vendor_account_payment"
              name="Account Payments"
              action="action_vendor_account_payment"
              parent="account.menu_finance_payables"
              sequence="20"/>

</odoo>