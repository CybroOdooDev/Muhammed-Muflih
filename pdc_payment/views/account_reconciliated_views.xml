<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_reconciled_view_tree" model="ir.ui.view">
        <field name="name">account.reconciled.tree</field>
        <field name="model">account.reconciled</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="move_line_id" column_invisible="1"/>
                <field name="payment_id"/>
                <field name="move_name"/>
                <field name="name" optional="hide"/>
                <field name="total_amount"/>
<!--                <field name="amount_due"/>-->
                <field name="amount" digits="[3,3]"/>
                <field name="partner_currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
<!--                <field name="partner_amount" widget="monetary" options="{'currency_field': 'partner_currency_id'}" digits="[3,3]"/>-->
            </list>
        </field>
    </record>
    <record id="bank_account_reconciled_action"
            model="ir.actions.act_window">
        <field name="name">Reconciled Action</field>
        <field name="res_model">account.reconciled</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account_reconciled_view_tree"/>
    </record>
</odoo>