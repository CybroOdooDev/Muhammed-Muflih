<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="payment_statement_view_form" model="ir.ui.view">
        <field name="name">payment.statement.view.form</field>
        <field name="model">payment.statement</field>
        <field name="arch" type="xml">
            <form string="Statement ">
                <group class="oe_title">
                    <field name="statement_type" widget="radio"/>

                    <label for="date_to" string="As on Date"/>
                    <div class="o_row">
<!--                        <field name="date_from" widget="daterange" nolabel="1" class="oe_inline"-->
<!--                               options="{'related_end_date': 'date_to'}"/>-->
<!--                        <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>-->
                        <field name="date_to" nolabel="1" class="oe_inline"/>
                    </div>
                    <field name="vendor_ids"  invisible="statement_type != 'vendor' or bulk_mail == True" widget="many2many_tags"
                           domain="[('supplier_rank','>', 0)]"/>
                    <field name="customer_ids" widget="many2many_tags"
                           invisible="statement_type != 'customer' or bulk_mail == True" domain="[('customer_rank','>', 0)]"/>
                    <field name="pdc_payment"/>
                    <field name="bulk_mail" invisible="statement_type not in ('vendor', 'customer')"/>
                    <field name="bulk_mail_id" invisible="not bulk_mail" domain="[('type', '=', statement_type)]" options="{'no_create': True}"/>
                    <field name="partner_line_ids" invisible="not bulk_mail">
                        <list editable="bottom">
                            <field name="partner_id"/>
                        </list>
                    </field>


                </group>
                <footer>
                    <button name="print_xls" string="Print Xls" type="object" class="btn-primary"/>
                    <button name="print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="print_html" string="View" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                    <button name="action_send_mail" string="Send Mail" type="object" class="btn-primary" invisible="not bulk_mail"/>

                </footer>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="payment_statement_action" model="ir.actions.act_window">
        <field name="name">Payment statement</field>
        <field name="res_model">payment.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu -->
    <menuitem id="payment_statement_menu"
              name="Payment statement"
              action="payment_statement_action"
              parent="account.account_reports_partners_reports_menu"
              sequence="12"/>
</odoo>