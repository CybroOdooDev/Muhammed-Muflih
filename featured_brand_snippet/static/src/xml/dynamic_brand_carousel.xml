<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="featured_brand_snippet.brand_snippet_carousel">

        <div class="position-relative px-3">

            <!-- Main Carousel -->
            <div t-att-id="carouselId"
                 class="carousel slide"
                 t-att-data-bs-ride="isEditMode ? undefined : 'carousel'"
                 t-att-data-bs-interval="isEditMode ? '0' : '5000'">

                <div class="carousel-inner">

                    <t t-foreach="chunks"
                       t-as="chunk"
                       t-key="chunk_index">

                        <div t-attf-class="carousel-item {{ chunk_index === 0 ? 'active' : '' }}">

                            <div class="row gx-2">

                                    <t t-foreach="chunk"
                                       t-as="item"
                                       t-key="item.id">

                                        <t t-if="item.empty">
                                            <div t-attf-class="{{ colClass }} mb-4 invisible d-none d-lg-block"
                                                 aria-hidden="true"/>
                                        </t>
                                        <t t-else="">
                                        <div t-attf-class="{{ colClass }} mb-4">

                                            <div class="card h-100 d-flex flex-column o_brand_card">

                                                <!-- Brand Image -->
                                                <div class="d-flex align-items-center justify-content-center p-3 flex-shrink-0 o_brand_img_wrap">

                                                    <img class="card-img-top img-fluid p-3 object-fit-contain o_brand_img"
                                                         t-att-src="'/web/image/product.brand/' + item.id + '/brand_image'"
                                                         t-att-alt="item.name"/>

                                                </div>

                                                <!-- Brand Details -->
                                                <div class="card-body d-flex flex-column flex-grow-1">

                                                    <h5 class="card-title text-center mb-2">
                                                        <t t-out="item.name"/>
                                                    </h5>

                                                    <a t-att-href="'/shop/brand/' + item.id"
                                                       t-attf-class="btn btn-primary mt-auto align-self-center {{ isEditMode ? 'pe-none' : '' }}">
                                                        View Products
                                                    </a>

                                                </div>

                                            </div>

                                        </div>
                                        </t>

                                    </t>

                            </div>

                        </div>

                    </t>

                </div>

                <t t-if="chunks.length &gt; 1">

                <!-- Previous Button -->
                <button class="carousel-control-prev o_brand_carousel_prev w-auto"
                        t-att-data-bs-target="'#' + carouselId"
                        data-bs-slide="prev"
                        type="button"
                        aria-label="Previous">

                    <span class="fa fa-chevron-circle-left fa-2x o_brand_carousel_icon"/>

                    <span class="visually-hidden">Previous</span>

                </button>

                <!-- Next Button -->
                <button class="carousel-control-next o_brand_carousel_next w-auto"
                        t-att-data-bs-target="'#' + carouselId"
                        data-bs-slide="next"
                        type="button"
                        aria-label="Next">

                    <span class="fa fa-chevron-circle-right fa-2x o_brand_carousel_icon"/>

                    <span class="visually-hidden">Next</span>

                </button>

                </t>

            </div>

        </div>

    </t>

</templates>