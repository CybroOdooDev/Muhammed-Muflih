<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_return_picking_form_cancel_purchase_order"
            model="ir.ui.view">
        <field name="name">stock.return.picking.inherit.form</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_return_moves']"
                   position="after">
                <group>
                    <field name="is_force_close" widget="boolean_toggle"
                           groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>