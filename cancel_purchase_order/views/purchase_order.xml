<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form">
        <field name="name">purchase.order.form.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
               <button type="object" name="action_force_cancel_order" groups="base.group_erp_manager"
                       string="Force Cancel" invisible="state!='purchase'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="is_force_cancel_state" invisible="1"/>
                <widget name="web_ribbon" title="Force Canceled" bg_color="bg-danger" invisible="is_force_cancel_state!=True"/>
            </xpath>
        </field>
    </record>
</odoo>