<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rule of group doctor to access doctor allocation records-->
        <record id="doctor_allocation_rule_doctor" model="ir.access">
            <field name="name">Doctor Allocation Rule Doctor</field>
            <field name="model_id" ref="model_doctor_allocation"/>
            <field name="group_id" ref="base_hospital_management.base_hospital_management_group_doctor"/>
            <field name="operation">crud</field>
            <field name="domain">[('doctor_id.user_id','=',user.id)]</field>
        </record>
        <!-- Record rule of group doctor to access manager allocation records-->
        <record id="doctor_allocation_rule_manager" model="ir.access">
            <field name="name">Doctor Allocation Rule Manager</field>
            <field name="model_id" ref="model_doctor_allocation"/>
            <field name="group_id" ref="base_hospital_management.base_hospital_management_group_manager"/>
            <field name="operation">crud</field>
            <field name="domain">[(1,'=',1)]</field>
        </record>
        <!-- Multi company rule for doctor allocation records-->
        <record id="doctor_allocation_rule_company" model="ir.access">
            <field name="name">Doctor Allocation Rule Company</field>
            <field name="model_id" ref="model_doctor_allocation"/>
            <field name="operation">crud</field>
            <field name="domain">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>