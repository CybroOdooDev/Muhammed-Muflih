<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- portal entry data -->
    <record id="portal_entry_op" model="portal.entry">
        <field name="name">OP</field>
        <field name="description">Outpatient appointments for medical consultations</field>
        <field name="url">/my/op</field>
        <field name="image" type="bytes" file="base_hospital_management/static/src/img/op_ticket.svg"/>
        <field name="placeholder_count">op_count</field>
        <field name="category">client_category</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="20"/>
    </record>

    <record id="portal_entry_vaccinations" model="portal.entry">
        <field name="name">Vaccinations</field>
        <field name="description">Preventive measure to protect against infectious diseases</field>
        <field name="url">/my/vaccinations</field>
        <field name="image" type="bytes" file="base_hospital_management/static/src/img/vaccination1.png"/>
        <field name="placeholder_count">vaccination_count</field>
        <field name="category">client_category</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="21"/>
    </record>

    <record id="portal_entry_lab_tests" model="portal.entry">
        <field name="name">Lab Tests</field>
        <field name="description">Tests provide valuable information for doctors to make treatment decisions</field>
        <field name="url">/my/tests</field>
        <field name="image" type="bytes" file="base_hospital_management/static/src/img/lab_test.svg"/>
        <field name="placeholder_count">lab_test_count</field>
        <field name="category">client_category</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="22"/>
    </record>
</odoo>
