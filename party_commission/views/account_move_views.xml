<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_party_commission" model="ir.ui.view">
        <field name="name">account.move.form.inherit.party.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="invoice_ids" widget="many2many_tags" invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
