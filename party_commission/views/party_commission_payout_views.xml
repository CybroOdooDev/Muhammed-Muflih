<odoo>
    <!--List view for model 'booking.provsion.line'-->
    <record id="booking_provsion_line_view_list" model="ir.ui.view">
        <field name="name">booking.provsion.line.view.list</field>
        <field name="model">booking.provsion.line</field>
        <field name="arch" type="xml">
            <list string="Party Commission Payout" delete="0">
                <field name="booking_provision_id"/>
                <field name="date"/>
                <field name="invoice_number"/>
                <field name="customer_id"/>
                <field name="item_code"/>
                <field name="qty" sum="Total Qty"/>
                <field name="price"/>
                <field name="total" sum="Total Amount"/>
                <field name="discount"/>
                <field name="net_sales" sum="Total Net Sales"/>
                <field name="cogs" sum="Total COGS" groups="party_commission.group_party_commission_manager"/>
                <field name="printing_charges" sum="Total Printing Charges"/>
                <field name="commission_percentage"/>
                <field name="commission_value" sum="Total Commission Value"/>
                <field name="net_commission" sum="Total Net Commission"/>
                <field name="paid"/>
                <field name="difference"/>
                <field name="profit" sum="Total Profit" groups="party_commission.group_party_commission_manager"/>
                <field name="profit_percentage" groups="party_commission.group_party_commission_manager"/>
            </list>
        </field>
    </record>

    <!--Form view for model 'booking.provsion.line'-->
    <record id="booking_provsion_line_view_form" model="ir.ui.view">
        <field name="name">booking.provsion.line.view.form</field>
        <field name="model">booking.provsion.line</field>
        <field name="arch" type="xml">
            <form string="Party Commission Payout" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="booking_provision_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="invoice_number" readonly="1"/>
                            <field name="item_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty" readonly="1"/>
                            <field name="price" readonly="1"/>
                            <field name="total" readonly="1"/>
                            <field name="discount" readonly="1"/>
                            <field name="net_sales" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commission &amp; Charges">
                            <field name="is_commission_readonly" invisible="1"/>
                            <field name="is_printing_charges_readonly" invisible="1"/>
                            <field name="printing_charges" readonly="is_printing_charges_readonly"/>
                            <field name="commission_percentage" readonly="is_commission_readonly"/>
                            <field name="commission_value" readonly="is_commission_readonly"/>
                            <field name="net_commission" readonly="1"/>
                            <field name="paid"/>
                            <field name="difference" readonly="1"/>
                        </group>
                        <group string="Profitability" groups="party_commission.group_party_commission_manager">
                            <field name="cogs" readonly="1"/>
                            <field name="profit" readonly="1"/>
                            <field name="profit_percentage" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Search view for model 'booking.provsion.line'-->
    <record id="booking_provsion_line_view_search" model="ir.ui.view">
        <field name="name">booking.provsion.line.view.search</field>
        <field name="model">booking.provsion.line</field>
        <field name="arch" type="xml">
            <search string="Party Commission Payout Search">
                <field name="booking_provision_id" string="Booking Provision"/>
                <field name="customer_id" string="Customer"/>
                <field name="invoice_number" string="Invoice Number"/>
                <field name="item_code" string="Item Code"/>
                <field name="date" string="Date"/>
                <group expand="0" string="Group By">
                    <filter string="Booking Provision" name="group_by_booking_provision_id" context="{'group_by': 'booking_provision_id'}"/>
                    <filter string="Customer" name="group_by_customer_id" context="{'group_by': 'customer_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Item Code" name="group_by_item_code" context="{'group_by': 'item_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--Action for model 'booking.provsion.line'-->
    <record id="booking_provsion_line_action" model="ir.actions.act_window">
        <field name="name">Party Commission Payout</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">booking.provsion.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="booking_provsion_line_view_list"/>
        <field name="search_view_id" ref="booking_provsion_line_view_search"/>
    </record>

    <!--Menu Item for Party Commission Payout-->
    <menuitem id="booking_provsion_line_menu"
              name="Party commission Payout"
              action="booking_provsion_line_action"
              parent="sale.menu_sale_invoicing"
              sequence="40"/>

</odoo>