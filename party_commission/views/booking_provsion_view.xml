<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Form view for model 'booking.provsion'-->
    <record id="booking_provsion_view_form" model="ir.ui.view">
        <field name="name">booking.provsion.view.form</field>
        <field name="model">booking.provsion</field>
        <field name="arch" type="xml">
            <form string="Booking Provsion" delete="0">
                <header>
                    <button name="action_to_review" string="To Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'to_review'" groups="party_commission.group_party_commission_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'to_review'" groups="party_commission.group_party_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_review,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bars"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_ids" widget="many2many_tags" readonly="1"/>
                            <field name="party_records" widget="many2many_tags" invisible="1"/>
                            <field name="all_party_confirmed" invisible="1"/>
                        </group>
                        <group>
                            <field name="from_date" readonly="1"/>
                            <field name="to_date" readonly="1"/>
                            <field name="sales_excutive_id" readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="commission_details">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date" readonly="1"/>
                                    <field name="invoice_number" readonly="1"/>
                                    <field name="customer_id" readonly="1"/>
                                    <field name="item_code" readonly="1"/>
                                    <field name="qty" sum="Total Qty" readonly="1"/>
                                    <field name="price" readonly="1"/>
                                    <field name="total" sum="Total Amount" readonly="1"/>
                                    <field name="discount" readonly="1"/>
                                    <field name="net_sales" sum="Total Net Sales" readonly="1"/>
                                    <field name="cogs" sum="Total COGS" readonly="1" groups="party_commission.group_party_commission_manager"/>
                                    <field name="is_commission_readonly" column_invisible="1"/>
                                    <field name="is_printing_charges_readonly" column_invisible="1"/>
                                    <field name="printing_charges" sum="Total Printing Charges" readonly="is_printing_charges_readonly"/>
                                    <field name="commission_percentage" readonly="is_commission_readonly"/>
                                    <field name="commission_value" sum="Total Commission Value" readonly="is_commission_readonly"/>
                                    <field name="net_commission" sum="Total Net Commission" readonly="1"/>
                                    <field name="profit" sum="Total Profit" readonly="1" groups="party_commission.group_party_commission_manager"/>
                                    <field name="profit_percentage" readonly="1" groups="party_commission.group_party_commission_manager"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="commission_percentage_on_sales" readonly="1"/>
                            </group>
                        </page>
                        <page string="Journal Entry" name="journal_entry" invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="date" readonly="all_party_confirmed"/>
                                    <field name="journal_id" readonly="all_party_confirmed" required="state in ('to_review', 'confirmed')"/>
                                    <field name="allowed_partner_ids" invisible="1"/>
                                </group>
                            </group>
                            <field name="journal_line_ids" readonly="all_party_confirmed">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="partner_id" domain="[('id', 'in', parent.allowed_partner_ids)]"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>



    <!--List view for model 'booking.provsion'-->
    <record id="booking_provsion_view_list" model="ir.ui.view">
        <field name="name">booking.provsion.view.list</field>
        <field name="model">booking.provsion</field>
        <field name="arch" type="xml">
            <list string="Booking Provsion" delete="0">
                <field name="name"/>
                <field name="customer_ids" widget="many2many_tags"/>
                <field name="move_id" string="Journal Entry"/>
                <field name="journal_id"/>
                <field name="date"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="booking_provsion_view_search" model="ir.ui.view">
        <field name="name">booking.provsion.view.search</field>
        <field name="model">booking.provsion</field>
        <field name="arch" type="xml">
            <search string="Booking Provision Search">
                <field name="name" string="Reference"/>
                <field name="customer_ids"/>
                <field name="date"/>
                <field name="journal_id"/>
                <group expand="0" string="Group By">
                    <filter string="Reference" name="group_by_name" context="{'group_by': 'name'}"/>
                    <filter string="Customer" name="group_by_customer_id" context="{'group_by': 'customer_ids'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Journal" name="group_by_journal_id" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--Action-->
    <record id="booking_provsion_action" model="ir.actions.act_window">
        <field name="name">Booking Provsion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">booking.provsion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="booking_provsion_view_search"/>
        <field name="context">{'search_default_group_by_name': 1}</field>
    </record>


    <!--Menu Item-->
    <menuitem id="booking_provsion_menu"
              name="Booking Provsion"
              action="booking_provsion_action"
              parent="sale.menu_sale_invoicing"
              sequence="30"/>


</odoo>
