<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Form view for model 'bulk.mail'-->
    <record id="booking_provsion_view_form" model="ir.ui.view">
        <field name="name">booking.provsion.view.form</field>
        <field name="model">booking.provsion</field>
        <field name="arch" type="xml">
            <form string="Booking Provsion" delete="true">
                <header>
                    <button name="action_to_review" string="To Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'to_review'" groups="party_commission.group_party_commission_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'to_review'" groups="party_commission.group_party_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_review,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bars"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="from_date" readonly="1"/>
                            <field name="to_date" readonly="1"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="commission_details">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date" readonly="1"/>
                                    <field name="invoice_number" readonly="1"/>
                                    <field name="customer_id" readonly="1"/>
                                    <field name="item_code" readonly="1"/>
                                    <field name="qty" sum="Total Qty" readonly="1"/>
                                    <field name="price" readonly="1"/>
                                    <field name="total" sum="Total Amount" readonly="1"/>
                                    <field name="discount" readonly="1"/>
                                    <field name="net_sales" sum="Total Net Sales" readonly="1"/>
                                    <field name="cogs" sum="Total COGS" readonly="1"/>
                                    <field name="is_commission_readonly" column_invisible="1"/>
                                    <field name="printing_charges" sum="Total Printing Charges" readonly="1"/>
                                    <field name="commission_percentage" readonly="is_commission_readonly"/>
                                    <field name="commission_value" sum="Total Commission Value" readonly="is_commission_readonly"/>
                                    <field name="net_commission" sum="Total Net Commission" readonly="1"/>
                                    <field name="profit" sum="Total Profit" readonly="1"/>
                                    <field name="profit_percentage" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Journal Entry" name="journal_entry" invisible="state != 'confirmed'">
                            <group>
                                <field name="move_id" readonly="1"/>
                            </group>
                            <field name="journal_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="account_id"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="commission_percentage_on_sales" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>



    <!--List view for model 'bulk.mail'-->
    <record id="booking_provsion_view_list" model="ir.ui.view">
        <field name="name">booking.provsion.view.list</field>
        <field name="model">booking.provsion</field>
        <field name="arch" type="xml">
            <list string="Booking Provsion" delete="true">
                <field name="name"/>
                <field name="customer_ids" widget="many2many_tags"/>
                <field name="from_date"/>
                <field name="to_date"/>
            </list>
        </field>
    </record>

    <!--Action for Customers Bulk Mail-->
    <record id="booking_provsion_action" model="ir.actions.act_window">
        <field name="name">Booking Provsion</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">booking.provsion</field>
        <field name="view_mode">list,form</field>
    </record>


    <!--Menu Item under Customers (Accounting)-->
    <menuitem id="booking_provsion_menu"
              name="Booking Provsion"
              action="booking_provsion_action"
              parent="sale.menu_sale_invoicing"
              sequence="30"/>


</odoo>
