<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="commission_payout_wizard_view_form" model="ir.ui.view">
        <field name="name">commission.payout.wizard.view.form</field>
        <field name="model">commission.payout.wizard</field>
        <field name="arch" type="xml">
            <form string="Commission Payout">
                <group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" required="1"/>
                        <field name="allowed_partner_ids" invisible="1"/>
                        <field name="payout_line_ids" invisible="1"/>
                        <field name="booking_provision_ids" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="account_id" required="1"/>
                        <field name="partner_id" domain="[('id', 'in', parent.allowed_partner_ids)]"/>
                        <field name="label"/>
                        <field name="analytic_account_id"/>
                        <field name="debit" sum="Total Debit"/>
                        <field name="credit" sum="Total Credit"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_journal" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="commission_payout_wizard_action" model="ir.actions.act_window">
        <field name="name">Commission Payout</field>
        <field name="res_model">commission.payout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
