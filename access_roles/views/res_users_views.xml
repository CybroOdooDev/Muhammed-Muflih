<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited Form View for Users -->
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.access.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('o_form_header_details')]" position="inside">
                <group>
                    <field name="access_role_id" invisible="id == uid"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>