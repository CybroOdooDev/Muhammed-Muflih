<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Root Menu for Access Role module -->
    <menuitem id="access_role_menu_root" name="Access Role" groups="access_roles.access_role_group_administrator"/>

    <!-- Category Menu: Role Management -->
    <menuitem id="access_role_menu" name="Role Management"
              parent="access_role_menu_root"/>

    <!-- Submenu: Access Roles (Manages user roles and assigned security groups) -->
    <menuitem id="access_role_menu_roles" action="action_access_role"
              parent="access_role_menu"/>

    <!-- Submenu: Role Management (Configures restrictions: hide menus, buttons, fields, domains) -->
    <menuitem id="access_role_menu_management" action="action_role_management"
              parent="access_role_menu"/>
</odoo>