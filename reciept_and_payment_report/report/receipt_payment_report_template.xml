<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Report Action for HTML View -->
    <record id="action_report_receipt_payment" model="ir.actions.report">
        <field name="name">Receipt &amp; Payment Report</field>
        <field name="model">receipt.payment.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">reciept_and_payment_report.receipt_payment_report_template</field>
        <field name="report_file">reciept_and_payment_report.receipt_payment_report_template</field>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Report Template -->
    <template id="receipt_payment_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center my-4 p-2 bg-light border">
                            <h3 class="m-0 fw-bold">
                                <span t-if="o.partner_type == 'customer'">RECEIPT REPORT</span>
                                <span t-else="">PAYMENT REPORT</span>
                            </h3>
                        </div>

                        <div class="row mb-4 fs-6">
                            <div class="col-6">
                                <strong>
                                    <span t-if="o.partner_type == 'customer'">Customer:</span>
                                    <span t-else="">Vendor:</span>
                                </strong>
                                <span t-out="o.partner_id.name if o.partner_id else ('All ' + (o.partner_type.title() if o.partner_type else 'Partner') + 's')"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>From Date:</strong> <span t-out="o.from_date"/>
                                <span class="mx-2">|</span>
                                <strong>To Date:</strong> <span t-out="o.to_date"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-3">
                            <thead class="bg-light text-center">
                                <tr>
                                    <th style="width: 8%;">SL NO</th>
                                    <th style="width: 15%;">DATE</th>
                                    <th style="width: 32%;">VOUCHER NO</th>
                                    <th style="width: 30%;">PAYMENT NO</th>
                                    <th style="width: 15%;" class="text-end">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines_data" t-value="o._get_report_lines()"/>
                                <t t-set="sl_no" t-value="1"/>
                                <t t-set="total_amount" t-value="0.0"/>
                                <t t-foreach="lines_data" t-as="line">
                                    <tr>
                                        <td class="text-center" t-out="sl_no"/>
                                        <td class="text-center" t-out="line['date']"/>
                                        <td t-out="line['voucher_no']"/>
                                        <td t-out="line['payment_no']"/>
                                        <td class="text-end" t-out="line['amount']" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                    </tr>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                    <t t-set="total_amount" t-value="total_amount + line['amount']"/>
                                </t>
                            </tbody>
                            <tfoot class="border-top border-dark">
                                <tr>
                                    <td colspan="4" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold">
                                        <span t-out="total_amount" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
