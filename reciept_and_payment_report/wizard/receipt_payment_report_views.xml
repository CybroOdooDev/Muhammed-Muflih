<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipt Payment Report Wizard Form View -->
    <record id="view_receipt_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">receipt.payment.report.wizard.form</field>
        <field name="model">receipt.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reciept Payment Report">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group>
                        <field name="partner_type" invisible="1"/>
                        <field name="partner_id" domain="[('customer_rank', '>', 0)] if partner_type == 'customer' else [('supplier_rank', '>', 0)]"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report_xlsx" string="Print Xls" type="object" class="btn-primary"/>
                    <button string="View" class="btn-primary" type="object" name="view_report"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Receipt Report Action -->
    <record id="action_receipt_report_wizard" model="ir.actions.act_window">
        <field name="name">Receipt Report</field>
        <field name="res_model">receipt.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_type': 'customer'}</field>
    </record>

    <!-- Payment Report Action -->
    <record id="action_payment_report_wizard" model="ir.actions.act_window">
        <field name="name">Payment Report</field>
        <field name="res_model">receipt.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_type': 'vendor'}</field>
    </record>

    <!-- Menu Items under Partner Reports -->
    <menuitem id="menu_receipt_report_wizard"
              name="Receipt Report"
              parent="account.account_reports_partners_reports_menu"
              action="action_receipt_report_wizard"
              sequence="10"/>

    <menuitem id="menu_payment_report_wizard"
              name="Payment Report"
              parent="account.account_reports_partners_reports_menu"
              action="action_payment_report_wizard"
              sequence="11"/>
</odoo>
