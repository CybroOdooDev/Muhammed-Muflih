<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="pos_order_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <h4>POS Order
                                <t t-esc="o.name"/>
                            </h4>
                            <div class="note" t-if="o.general_customer_note">
                                <t t-esc="o.general_customer_note"/>
                            </div>
                            <div id="informations" class="row mt-4 mb-4">
                                <div class="col-auto col-3 mw-100 mb-2">
                                    <strong>Due Date:</strong>
                                    <p class="m-0" t-field="o.date_order"/>
                                </div>
                                <div class="col-auto col-3 mw-100 mb-2">
                                    <strong>Cashier</strong>
                                    <p class="m-0" t-esc="o.user_id.name"/>
                                </div>
                                <div class="col-auto col-3 mw-100 mb-2">
                                    <strong>Session</strong>
                                    <p class="m-0" t-esc="o.session_id.name"/>
                                </div>
                                <div class="col-auto col-3 mw-100 mb-2">
                                    <strong>Point of Sale</strong>
                                    <p class="m-0"
                                       t-esc="o.session_id.config_id.name"/>
                                </div>
                            </div>
                            <div id="information" class="row mt-4 mb-4">
                                <div class="col-auto col-3 mw-100 mb-2">
                                    <strong>Customer</strong>
                                    <p class="m-0" t-esc="o.partner_id.name"/>
                                </div>
                                <div class="col-auto col-3 mw-100 mb-2" t-if="o._fields.get('account_analytic_id') and o.account_analytic_id">
                                    <strong>Analytic Account</strong>
                                    <p class="m-0"
                                       t-esc="o.account_analytic_id.name"/>
                                </div>
                            </div>
                            <h6>Products</h6>
                            <table width="100" class="table">
                                <thead>
                                    <tr>
                                        <th>Full Product Name</th>
                                        <th>Lot/Serial Number</th>
                                        <th>Quantity</th>
                                        <th>UoM</th>
                                        <th>Unit Price</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.lines" t-as="line">
                                        <td>
                                            <t t-if="line._fields.get('product_ref') and line.product_ref">[<t t-esc="line.product_ref"/>] </t>
                                            <t t-esc="line.full_product_name"/>
                                        </td>
                                        <td>
                                            <ul style="list-style-type: none;">
                                                <li t-foreach="line.pack_lot_ids.mapped('lot_name')"
                                                    t-as="lot">
                                                    <t t-esc="lot"/>
                                                </li>
                                            </ul>
                                        </td>
                                        <td>
                                            <t t-esc="line.qty"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="'%.3f' % line.price_unit"/>
                                            <t t-esc="line.currency_id.symbol"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'%.3f' % line.price_subtotal"/>
                                            <t t-esc="line.currency_id.symbol"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <h6>Payments</h6>
                            <table width="100" class="table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th class="text-center">Reference</th>
                                        <th class="text-center">Payment Method
                                        </th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.payment_ids" t-as="line">
                                        <td>
                                            <p t-field="line.payment_date"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-if="line._fields.get('pos_reference')"><t t-esc="line.pos_reference"/></t>
                                            <t t-else=""><t t-esc="line.name"/></t>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="line.payment_method_id.name"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="line.amount"/>
                                            <t t-esc="line.currency_id.symbol"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
            </t>
        </t>
    </template>
</odoo>