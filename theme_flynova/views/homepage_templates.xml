<?xml version="1.0" encoding="utf-8"?>
<!-- Inherits the Odoo website homepage template to assemble the Flynova homepage from its custom snippet sections. -->
<odoo>
    <data>
        <template id="homepage_flynova_arch" inherit_id="website.homepage" name="Flynova Homepage">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure">
                    <t t-call="theme_flynova.s_flynova_hero"/>
                    <t t-call="theme_flynova.s_flynova_destinations"/>
                    <t t-call="theme_flynova.s_flynova_featured_tours"/>
                    <t t-call="theme_flynova.s_flynova_hotels"/>
                    <t t-call="theme_flynova.s_flynova_features"/>
                    <t t-call="theme_flynova.s_flynova_activities"/>
                    <t t-call="theme_flynova.s_flynova_traveler_photos"/>
                    <t t-call="theme_flynova.s_flynova_discover"/>
                    <div class="oe_structure"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
