<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Template: homepage_flynova_arch
            Inherits: website.homepage
            Replaces the standard #wrap div with the Flynova home page composed
            of the following sections (called in order):
              1. s_flynova_hero            – Hero banner with booking search bar.
              2. s_flynova_destinations    – Featured destination cards carousel.
              3. s_flynova_featured_tours  – Highlighted tour packages grid.
              4. s_flynova_hotels          – Featured hotel listings grid.
              5. s_flynova_features        – Why-choose-us / USP feature blocks.
              6. s_flynova_activities      – Activities / experience highlights.
              7. s_flynova_traveler_photos – Traveller photo testimonial gallery.
              8. s_flynova_discover        – Newsletter / discover-more CTA banner.
        -->
        <template id="homepage_flynova_arch" inherit_id="website.homepage" name="Flynova Homepage">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure">
                    <t t-call="theme_flynova.s_flynova_hero"/>
                    <t t-call="theme_flynova.s_flynova_destinations"/>
                    <t t-call="theme_flynova.s_flynova_featured_tours"/>
                    <t t-call="theme_flynova.s_flynova_hotels"/>
                    <t t-call="theme_flynova.s_flynova_features"/>
                    <t t-call="theme_flynova.s_flynova_activities"/>
                    <t t-call="theme_flynova.s_flynova_traveler_photos"/>
                    <t t-call="theme_flynova.s_flynova_discover"/>
                    <div class="oe_structure"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
