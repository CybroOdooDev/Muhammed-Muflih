<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    PDF Report Template-->
    <template id="pl_report_temp">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="row border-bottom pb-2 mb-4">
                        <div class="col-4">
                            <span t-out="today"/>
                        </div>
                        <div class="col-4 text-center">
                            <span t-out="env.company.name"/>
                        </div>
                        <div class="col-4 text-end">
                            <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                    <h2>Profit and Loss</h2>
                    <div class="row mt32 mb32">
                        <div class="col-4">
                            <strong>Target Moves:</strong>
                        </div>
                        <div class="col-4">
                            <p>
                                <t t-if="start_date">
                                    <strong>Date from :</strong>
                                    <span t-out="start_date"/>
                                    <br/>
                                </t>
                                <t t-if="end_date">
                                    <strong>Date to :</strong>
                                    <span t-out="end_date"/>
                                </t>
                            </p>
                        </div>
                    </div>
                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th class="text-center">Name</th>
                                <th class="text-end">Balance</th>
                            </tr>
                            <tr>
                                <th class="text-start">Net Profit</th>
                                <td>
                                    <span t-out="net_profit"/>
                                </td>
                            </tr>
                            <tr>
                                <th class="text-start">Income</th>
                                <td>
                                    <span t-out="income"/>
                                </td>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-3">
                                    Gross Profit</th>
                                <td>
                                    <span t-out="gross_profit"/>
                                </td>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-4">
                                    Operating Income</th>
                                <td>
                                    <span t-out="total_op_income"/>
                                </td>
                            </tr>
                            <tr t-foreach="operating_income" t-as="opincome">
                                <td class="fw-normal text-start ps-5"
                                    t-out="opincome['account_name']"/>
                                <td t-out="opincome['sum']"/>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-4">
                                    Cost Of Revenue</th>
                                <td>
                                    <span t-out="total_cor"/>
                                </td>
                            </tr>
                            <tr t-foreach="cost_of_revenue" t-as="cor">
                                <td class="fw-normal text-start ps-5"
                                    t-out="cor['account_name']"/>
                                <td t-out="cor['sum']"/>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-4">
                                    Other Income</th>
                                <td>
                                    <span t-out="total_other_income"/>
                                </td>
                            </tr>
                            <tr t-foreach="other_income" t-as="other">
                                <td class="fw-normal text-start ps-5"
                                    t-out="other['account_name']"/>
                                <td t-out="other['sum']"/>
                            </tr>
                            <tr>
                                <th class="text-start">Expenses</th>
                                <td>
                                    <span t-out="net_expense"/>
                                </td>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-4">Expense</th>
                                 <td>
                                    <span t-out="total_expense"/>
                                </td>
                            </tr>
                            <tr t-foreach="expense" t-as="exp">
                                <td class="fw-normal text-start ps-5" t-out="exp['account_name']"/>
                                <td t-out="exp['debit']"/>
                            </tr>
                             <tr>
                                <th class="fw-normal text-start ps-4">Depreciation</th>
                                 <td>
                                    <span t-out="total_depreciation"/>
                                </td>
                            </tr>
                            <tr t-foreach="depreciation" t-as="dep">
                                <td class="fw-normal text-start ps-5" t-out="dep['account_name']"/>
                                <td t-out="dep['credit']"/>
                            </tr>
                            <tr>
                                <th class="fw-normal text-start ps-4">Other Expenses</th>
                                <td>
                                    <span t-out="total_other_expense"/>
                                </td>
                            </tr>
                            <tr t-foreach="other_expense" t-as="otherexp">
                                <td class="fw-normal text-start ps-5" t-out="otherexp['account_name']"/>
                                <td t-out="otherexp['balance']"/>
                            </tr>
                        </thead>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>

