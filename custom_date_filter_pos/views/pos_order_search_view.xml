<odoo>
    <!-- Inherit the pos order search view to add customer phone column -->
    <record model="ir.ui.view" id="view_pos_order_filter">
        <field name="name">pos.order.inherit.view.search</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_phone" string="Customer Mobile"/>
            </xpath>
        </field>
    </record>
    <!-- Inherit the pos order tree view to add customer phone column -->
    <record model="ir.ui.view" id="view_pos_order_tree_inherit">
        <field name="name">pos.order.inherit.view.list</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_phone" string="Customer Mobile" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>