<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--  Record rule of group doctor to access patient booking records-->
        <record id="patient_booking_rule_doctor" model="ir.access">
            <field name="name">Patient Booking Rule Doctor</field>
            <field name="model_id" ref="model_patient_booking"/>
            <field name="group_id" ref="base_hospital_management.base_hospital_management_group_doctor"/>
            <field name="operation">crud</field>
            <field name="domain">[('doctor_id.doctor_id.user_id','=',user.id)]</field>
        </record>
        <!--        Multi company rule for doctor allocation records-->
        <record id="patient_booking_rule_company" model="ir.access">
            <field name="name">Patient Booking Rule Company</field>
            <field name="model_id" ref="model_patient_booking"/>
            <field name="operation">crud</field>
            <field name="domain">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>