<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Record rule of group lab assistant to access patient lab test records-->
        <record id="patient_lab_test_rule_lab_assistant" model="ir.access">
            <field name="name">Patient Lab Test Rule Lab Assistant</field>
            <field name="model_id" ref="model_patient_lab_test"/>
            <field name="group_id" ref="base_hospital_management.base_hospital_management_group_lab_assistant"/>
            <field name="operation">crud</field>
            <field name="domain">['|','|',('lab_id.technician_id.user_id','=',user.id),('lab_id.technician_id.user_id','=',False),('lab_id','=',False)]</field>
        </record>
        <!--Multi company rule for patient lab test records-->
        <record id="patient_lab_test_rule_company" model="ir.access">
            <field name="name">Patient Lab Test Rule Company</field>
            <field name="model_id" ref="model_patient_lab_test"/>
            <field name="operation">crud</field>
            <field name="domain">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>