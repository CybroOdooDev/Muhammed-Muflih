<?xml version="1.0" encoding="utf-8"?>
<template>
    <!-- Template for instruction -->
    <t t-name="text_commander.ModelItemsCommand">
        <div class="ms-4 p-2">
            <div>
                <strong>Open Record:</strong>
            </div>
            <div class="ms-4">!Open &lt;Model Name&gt;/Value</div>
            <div class="ms-4">!Open &lt;Model Name&gt; &lt;of/in&gt; &lt;field name&gt; &gt;value&gt;</div>
            <div class="ms-4">Eg: !Open sales order/S00016</div>
            <div class="ms-5">!Open sales order of customer azure</div>
            <div class="mt-2">
                <strong>Create Record:</strong>
            </div>
            <div class="ms-4">!Create &lt;Model Name&gt;</div>
            <div class="ms-4">Eg: !Create purchase order</div>
        </div>
    </t>
</template>
