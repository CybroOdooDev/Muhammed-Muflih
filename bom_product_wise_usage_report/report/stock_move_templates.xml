<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Template of report with ID bom_usage_report-->
    <template id="stock_move_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h2 align = "center">BOM Product Usage</h2>
                    <div class="col-xs-3">
                        <t t-if="from_date"><strong>Date from :</strong> <span t-out="from_date"/><br/></t>
                        <t t-if="to_date"><strong>Date to :</strong> <span t-out="to_date"/><br/></t>
                    </div>
                    <table class="table table-sm mt-3">
                        <thead>
                            <tr>
                                <th class="text-start" style="width: 30%;">Component Products</th>
                                <th class="text-start" style="width: 35%;">Final Products</th>
                                <th class="text-end" style="width: 20%;">Quantity Used</th>
                                <th class="text-center" style="width: 15%;">UoM</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="heading" t-as="bom">
                                <tr style="background-color: #f8f9fa;">
                                    <td colspan="4">
                                        <strong>
                                            <span t-out="bom.get('child_product_name')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <t t-foreach="body" t-as="doc2">
                                    <tr t-if="bom['child_product_name'] == doc2['child_product_name']">
                                        <td></td>
                                        <td class="text-start">
                                            <span t-out="doc2['parent_product_name']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="doc2['child_quantity_used']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-out="doc2['uom']"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
