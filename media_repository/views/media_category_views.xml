<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <!--  FORM VIEW-->
    <record id="media_category_view_form" model="ir.ui.view">
        <field name="name">media.category.form</field>
        <field name="model">media.category</field>
        <field name="arch" type="xml">
            <form string="Media Category">
                <sheet>
                    <group>
                       <field name="name" placeholder="Media Name…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <!--LIST VIEW-->
    <record id="media_category_view_list" model="ir.ui.view">
        <field name="name">media.category.list</field>
        <field name="model">media.category</field>
        <field name="arch" type="xml">
            <tree string="Media Category">
                <field name="name"/>
            </tree>
        </field>
    </record>



     <!--ACTION-->
    <record id="media_category_action" model="ir.actions.act_window">
        <field name="name">Media Category</field>
        <field name="res_model">media.category</field>
        <field name="view_mode">list,form</field>

    </record>



     <menuitem id="menu_media_category"
              name="Media Category"
              parent="media_repository_root_menu"
              action="media_category_action"
              sequence="11"/>
</odoo>





