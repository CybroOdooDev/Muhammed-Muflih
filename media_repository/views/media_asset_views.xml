<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ACTION -->
    <record id="action_media_asset" model="ir.actions.act_window">
        <field name="name">Media Assets</field>
        <field name="res_model">media.asset</field>
        <field name="context">{'search_default_admin_records':1}</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first media asset!
            </p>
            <p>
                Store images, videos, documents, audio files and external URLs
                in one centralised repository.
            </p>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_media_asset_form" model="ir.ui.view">
        <field name="name">media.asset.form</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <form string="Media Asset">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="confirm" string="Confirm" class="btn btn-primary" invisible="state == 'confirmed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Media Name…" readonly="state == 'confirmed'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="media_type" readonly="state == 'confirmed'"/>
                            <field name="category_id" readonly="state == 'confirmed'"/>
                            <field name="source_type" readonly="state == 'confirmed'"/>
                        </group>
                        <group string="Upload Info">
                            <field name="create_uid" readonly="state == 'confirmed'"/>
                            <field name="create_date" readonly="state == 'confirmed'"/>
                            <field name="favorite" readonly="state == 'confirmed'"/>
                            <field name="media_tag_ids" widget="many2many_tags" readonly="state == 'confirmed'"/>
                        </group>
                    </group>

                    <group string="Upload">
                        <field name="file" filename="file_name" widget="media_large_file" invisible="source_type == 'url' or not source_type" readonly="state == 'confirmed'"/>
                        <field name="source_url" widget="url" placeholder="https://…" invisible="source_type == 'file' or not source_type" readonly="state == 'confirmed'"/>
                        <field name="file_name" invisible="source_type == 'url' or not source_type" readonly="state == 'confirmed'"/>
                        <field name="file_size" invisible="source_type == 'url' or not source_type" readonly="state == 'confirmed'"/>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Enter a description…" readonly="state == 'confirmed'"/>
                    </group>
                </sheet>
               <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_media_asset_kanban" model="ir.ui.view">
        <field name="name">media.asset.kanban</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="o_kanban_attachment flex-row">
                        <aside class="o_kanban_image m-1">
                            <div class="o_kanban_image_wrapper d-flex align-items-center justify-content-center ps-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-primary-subtle p-3" invisible="media_type != 'image'">
                                    <i class="oi oi-2x text-primary" data-icon="image" title="Image" aria-label="Image"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-danger-subtle p-3" invisible="media_type != 'video'">
                                    <i class="oi oi-2x text-danger" data-icon="videocam" title="Video" aria-label="Video"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-success-subtle p-3" invisible="media_type != 'document'">
                                    <i class="oi oi-2x text-success" data-icon="description" title="Document" aria-label="Document"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-info-subtle p-3" invisible="media_type != 'audio'">
                                    <i class="oi oi-2x text-info" data-icon="music_note" title="Audio" aria-label="Audio"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-warning-subtle p-3" invisible="media_type != 'url'">
                                    <i class="oi oi-2x text-warning" data-icon="link" title="URL" aria-label="URL"/>
                                </div>
                            </div>
                        </aside>
                        <main class="ms-1">
                            <div class="o_kanban_details_wrapper d-flex flex-column">
                                <field name="name" class="text-truncate fw-bold fs-5"/>
                                <div class="d-flex pt-2">
                                    <field name="media_type"/>
                                    <field name="create_uid" widget="many2one_avatar_user" class="ms-auto"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_media_asset_list" model="ir.ui.view">
        <field name="name">media.asset.list</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <list string="Media Assets">
                <field name="name"/>
                <field name="media_type"/>
                <field name="category_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_media_asset_search" model="ir.ui.view">
        <field name="name">media.asset.search</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <search string="Search Media Assets">
                <field name="name"/>
                <field name="category_id"/>

                <filter name="filter_image"
                        string="Images"
                        domain="[('media_type','=','image')]"/>

                <filter name="filter_video"
                        string="Videos"
                        domain="[('media_type','=','video')]"/>

                <filter name="filter_url"
                        string="URL"
                        domain="[('media_type','=','url')]"/>

                <filter name="filter_document" string="Documents" domain="[('media_type','=','document')]"/>
                <filter name="filter_favourite" string="Favourites" domain="[('favorite','=',True)]"/>
                <filter name="admin_records" string="My Records" domain="[('create_uid', '=', uid)]" groups="media_repository.group_manager"/>

                <filter name="media_type"
                        string="Media Type"
                        context="{'group_by':'media_type'}"/>

                <filter name="group_by_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <!-- MENU ITEMS -->
    <menuitem id="menu_media_repository_root"
              name="Media Repository"
              web_icon="media_repository,static/description/icon.png"
              sequence="11"/>
    <menuitem id="menu_media_repository_configuration"
              name="Configuration"
              parent="menu_media_repository_root"
              sequence="20"/>

    <menuitem id="menu_media_assets"
              name="Media Assets"
              parent="menu_media_repository_root"
              action="action_media_asset"
              sequence="11"/>
</odoo>
