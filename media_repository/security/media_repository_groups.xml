<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module Category -->
        <record id="media_repository_category" model="ir.module.category">
            <field name="name">Media Repository</field>
            <field name="description">Media Repository Access Rights</field>
        </record>

        <!-- User Group: base level, no implied groups -->
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="media_repository_category"/>
        </record>

        <!-- Manager Group-->
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="media_repository_category"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- Assign user_root and admin to Manager on first install only -->
        <record id="group_manager" model="res.groups">
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
