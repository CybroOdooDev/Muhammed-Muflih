<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="media_repository.LargeFileBinaryField">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <t t-if="!this.props.record.resId">
                <span class="text-muted fst-italic">Save the record first to upload a file.</span>
            </t>
            <t t-else="">
                <t t-if="this.hasFile">
                    <a href="#" class="fw-bold" t-on-click.prevent="this.onFileDownload" t-out="this.fileName"/>
                    <button t-if="!this.props.readonly" class="btn btn-sm btn-link text-danger p-0"
                            type="button" t-on-click="this.onFileRemove" data-tooltip="Remove">
                        <i class="oi" data-icon="delete" role="img" aria-label="Remove"/>
                    </button>
                </t>
                <FileInput t-if="!this.props.readonly"
                           route="this.uploadRoute"
                           resModel="this.props.record.resModel"
                           resId="this.props.record.resId"
                           onUpload.bind="this.onFileUploaded">
                    <button class="btn btn-sm btn-secondary" type="button">
                        <i class="oi" data-icon="upload" role="img" aria-label="Upload"/> Upload
                    </button>
                </FileInput>
            </t>
        </div>
    </t>

</templates>
