<?xml version="1.0" encoding="UTF-8"?>
<!--
    Systray Item Template for Easy ChatGPT Access.
    Renders the ChatGPT button in the Odoo navbar (systray)
    to trigger the ChatGPT Assistant dialog.
-->
<templates xml:space="preserve">
    <t t-name="easy_chatgpt_access.SystrayIcon">
        <div class="o_nav_entry d-flex align-items-center">
            <button class="btn btn-link p-2 text-reset shadow-none border-0 d-flex align-items-center justify-content-center"
                    t-on-click="this._onClick"
                    title="ChatGPT"
                    aria-label="ChatGPT"
                    type="button">
                <i id="chatgpt_btn" class="oi oi-lg" data-icon="wand_stars" role="img"/>
            </button>
        </div>
    </t>
</templates>