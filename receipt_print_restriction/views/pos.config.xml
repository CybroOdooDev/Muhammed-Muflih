<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_disable_configuration_form" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">

                <!-- Receipt restriction -->
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="pos_receipt_restriction"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_receipt_restriction" string="Restrict Receipt Printing"/>
                        <br/>
                        <field name="pos_restriction_limit" invisible="pos_receipt_restriction == False"/>
                        <div class="text-muted">
                            Restrict receipt printing, Set a print limit
                        </div>
                    </div>
                </div>

                <!-- White label receipt toggle -->
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="pos_white_label_receipt"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_white_label_receipt" string="White Label Receipt"/>
                        <div class="text-muted">
                            Enable white label receipt with custom branch information
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>