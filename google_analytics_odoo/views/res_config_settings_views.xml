<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting the config settings to add fields for connecting Google Analytics -->
    <record id="res_config_settings_view_form_inherit_google_analytics_odoo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.analytics.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invite_users']" position="after">
                <block title="Google Analytics" name="google_analytics_setting_container">
                    <setting id="google_analytics_settings" string="Google Analytics" help="Enable to send events to Google Analytics">
                        <field name="enable_analytics"/>
                        <div class="content-group" invisible="not enable_analytics">
                            <div class="row mt16">
                                <label class="col-lg-3" string="Measurement ID" for="measurement_id_analytics"/>
                                <field name="measurement_id_analytics"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3" string="API Secret" for="api_secret"/>
                                <field name="api_secret"/>
                            </div>
                            <div class="text-muted mt8">
                                Please ensure that the measurement ID and API secret are valid and provided accurately.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
