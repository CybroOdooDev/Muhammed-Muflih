<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_book_order.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']" position="before">
            <t t-if="this.pos.config.enable"
               t-call="point_of_sale.controlButton"
               icon="'book'"
               btnText.translate="Booking"
               btnClasses="'btn-secondary '"
               onClick="() => this.bookOrder()">
            </t>
            <t t-if="this.pos.config.enable"
               t-call="point_of_sale.controlButton"
               icon="'list'"
               btnText.translate="Booked Orders"
               btnClasses="'btn-secondary '"
               onClick="() => this.getBookingOrders()">
            </t>
        </xpath>
    </t>
</templates>
