<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
    <!-- Inherit pos order receipt to add booking information -->
        <template id="pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
            <xpath expr="//div[@name='before-footer']" position="before">
                <t t-if="extra_data.get('booking_info')">
                    <hr style="border: none; border-top: 1px dashed black; margin: 10px 0;"/>
                    <table class="w-100 my-2">
                        <tbody>
                            <tr t-if="extra_data['booking_info'].get('name')">
                                <td class="text-start">Booking Ref:</td>
                                <td class="text-end font-monospace" t-out="extra_data['booking_info']['name']"/>
                            </tr>
                            <tr t-if="extra_data['booking_info'].get('phone')">
                                <td class="text-start">Contact No.:</td>
                                <td class="text-end font-monospace" t-out="extra_data['booking_info']['phone']"/>
                            </tr>
                            <tr t-if="extra_data['booking_info'].get('note')">
                                <td class="text-start">Order Note:</td>
                                <td class="text-end" t-out="extra_data['booking_info']['note']"/>
                            </tr>
                            <tr t-if="extra_data['booking_info'].get('pickup')">
                                <td class="text-start">Pickup Date:</td>
                                <td class="text-end font-monospace" t-out="extra_data['booking_info']['pickup']"/>
                            </tr>
                            <tr t-if="extra_data['booking_info'].get('deliver')">
                                <td class="text-start">Delivery Date:</td>
                                <td class="text-end font-monospace" t-out="extra_data['booking_info']['deliver']"/>
                            </tr>
                            <tr t-if="extra_data['booking_info'].get('address')">
                                <td class="text-start">Delivery address:</td>
                                <td class="text-end" t-out="extra_data['booking_info']['address']"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
