<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <template id="internal_layout" inherit_id="web.internal_layout" primary="True">
          <xpath expr="//div[hasclass('header')]" position="replace">
              <div class="header">
                  <div class="row" style="height: 5px"/>
                  <div class="row">
                      <div class="col-2 offset-3 text-start">
                        <ul class="list-inline">
                            <li class="list-inline-item"><span class="page"/></li>
                            <li class="list-inline-item">/</li>
                            <li class="list-inline-item"><span class="topage"/></li>
                        </ul>
                    </div>
                    <span t-esc="custom"/>
                </div>
            </div>
          </xpath>
     </template>

    <template id="report_stock_info">
        <t t-call="web.html_container">
            <t t-call="inventory_stock_report_extends.internal_layout">
                <t t-set="warehouse_id" t-value="warehouse"/>
                <t t-set="custom" t-value="header"/>
                <table width="100" class="table" style="margin:0;">
                    <thead>
                        <tr id="table_head">
                            <th class="text-start" style="margin: 0;padding: 0;">Item reference</th>
                            <th class="text-start" style="margin: 0;padding: 0;">Item name</th>
                            <th class="text-start" style="margin: 0;padding: 0;">Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_quantity" t-value="0"/>
                        <tr t-foreach="data" t-as="d">
                            <t t-set="total_quantity" t-value="total_quantity + d['qty_available']"/>
                            <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="d['default_code']"/></td>
                            <td class="text-start" style="font-size: 13px; padding: 3px;"><t t-esc="d['name']"/></td>
                            <td class="text-start final-td" style="font-size: 11px; padding: 3px;"><t t-esc="d['qty_available']"/></td>
                        </tr>
                        <tr id="total_row">
                            <td></td>
                            <td></td>
                            <td style="font-size: 13px;"><t t-out="total_quantity"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

     <template id="stock_info_with_cost" inherit_id="inventory_stock_report_extends.report_stock_info" primary="True">
        <xpath expr="//tr[@id='table_head']" position="inside">
            <th class="text-start" style="margin: 0;padding: 0;">Cost</th>
            <th class="text-start" style="margin: 0;padding: 0;">Total Value</th>
            <t t-set="total_cost" t-value="0"/>
            <t t-set="total_value" t-value="0"/>
        </xpath>
         <xpath expr="//td[hasclass('final-td')]" position="after">
            <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="round(d['avg_cost'],3)"/></td>
            <td class="text-start" style="font-size: 11px;  padding: 3px;"><t t-esc="round(d['total_value'],3)"/></td>
             <t t-set="total_cost" t-value="total_cost + d['avg_cost']"/>
             <t t-set="total_value" t-value="total_value + d['total_value']"/>
         </xpath>
         <xpath expr="//tr[@id='total_row']" position="inside">
                <td style="font-size: 13px;"><t t-out="round(total_cost,3)"/></td>
                <td style="font-size: 13px;"><t t-out="round(total_value,3)"/></td>
         </xpath>
    </template>

    <template id="info_cost_serial" inherit_id="inventory_stock_report_extends.report_stock_info" primary="True">
        <xpath expr="//tr[@id='table_head']" position="inside">
            <th class="text-start">Cost</th>
            <th class="text-start">Total Value</th>
        </xpath>
        <xpath expr="//tbody" position="replace">
            <tbody>
                <t t-set="total_quantity" t-value="0"/>
                <t t-set="total_cost" t-value="0"/>
                <t t-set="total_value" t-value="0"/>
                <t t-foreach="data" t-as="d">
                     <t t-set="total_cost" t-value="total_cost + d['avg_cost']"/>
                     <t t-set="total_value" t-value="total_value + d['total_value']"/>
                     <t t-set="total_quantity" t-value="total_quantity + d['qty_available']"/>
                    <tr>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="d['default_code']"/></td>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="d['name']"/></td>
                        <td class="text-start final-td" style="font-size: 11px; padding: 3px;"><t t-esc="d['qty_available']"/></td>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="round(d['avg_cost'],3)"/></td>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="round(d['total_value'],3)"/></td>
                    </tr>
                    <t t-set="sequence" t-value="d['serials']"/>
                    <tr t-if="sequence">
                        <td colspan="5" style="margin: 0;padding: 0;">
                            <table width="100" class="table" style="font-size:12px;margin:0px;padding:0;">
                                <tbody>
                                    <tr t-foreach="sequence" t-as="seq">
                                        <td style="margin: 0;padding: 0;"><t t-esc="seq[0]"/></td>
                                        <td style="margin: 0;padding: 0;"><t t-esc="seq[1]"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </t>
                <tr id="total_row">
                    <td></td>
                    <td></td>
                    <td style="font-size: 13px;"><t t-out="total_quantity"/></td>
                     <td style="font-size: 13px;"><t t-out="round(total_cost,3)"/></td>
                    <td style="font-size: 13px;"><t t-out="round(total_value,3)"/></td>
                </tr>
            </tbody>
        </xpath>
    </template>

    <template id="info_with_serial" inherit_id="inventory_stock_report_extends.report_stock_info" primary="True">
        <xpath expr="//tbody" position="replace">
            <tbody>
                 <t t-set="total_quantity" t-value="0"/>
                <t t-foreach="data" t-as="d">
                    <t t-set="total_quantity" t-value="total_quantity + d['qty_available']"/>
                    <tr>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="d['default_code']"/></td>
                        <td class="text-start" style="font-size: 11px; padding: 3px;"><t t-esc="d['name']"/></td>
                        <td class="text-start final-td" style="font-size: 11px; padding: 3px;"><t t-esc="d['qty_available']"/></td>
                    </tr>
                    <t t-set="sequence" t-value="d['serials']"/>
                    <tr t-if="sequence!=False">
                        <td colspan="5" style="margin: 0;padding: 0;">
                            <table width="100" class="table" style="font-size:12px;margin:0px;">
                                <tbody>
                                    <tr t-foreach="sequence" t-as="seq">
                                        <td style="margin: 0;padding: 0; padding-left:20px;"><t t-esc="seq[0]"/></td>
                                        <td style="margin: 0;padding: 0;"><t t-esc="seq[1]"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </t>
                <tr id="total_row">
                    <td></td>
                    <td></td>
                    <td style="font-size: 13px;"><t t-out="total_quantity"/></td>
                </tr>
            </tbody>
        </xpath>
    </template>

    <template id="available_device">
        <t t-call="web.html_container">
            <t t-call="inventory_stock_report_extends.internal_layout">
                <t t-set="custom" t-value="header"/>
                <table width="100" class="table" style="margin:0;">
                    <thead>
                        <tr id="table_head">
                            <th class="text-start" style="margin: 0;padding: 0;">Reference</th>
                            <th class="text-start" style="margin: 0;padding: 0;">Item name</th>
                            <th class="text-start" style="margin: 0;padding: 0;">Serial</th>
                            <th class="text-start" style="margin: 0;padding: 0; width:110px;">Purchase Date</th>
                            <th class="text-start" style="margin: 0;padding: 0;">Unit Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data" t-as="d">
                            <td><t t-out="d['default_code']"/></td>
                            <td><t t-out="d['item']"/></td>
                            <td><t t-out="d['name']"/></td>
                            <td><t t-out="d['purchase_date'].date()"/></td>
                            <td><t t-out="round(d['price_unit'], 3)"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>