<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_disable_configuration_form" model="ir.ui.view">
            <field name="name">pos.config.form.view.inherited</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id"
                   ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Customer Tags"
                                       for="company_customer_category_ids"/><br/>
                            <field name="company_customer_category_ids" widget="many2many_tags"/>
                        </div>
                         <div class="o_setting_right_pane">
                            <div>
                                <label string="Vendor Tags"
                                       for="company_vendor_category_ids"/>
                                <div class="content-group mt16">
                                    <field name="company_vendor_category_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                 </xpath>
            </field>
    </record>
</odoo>