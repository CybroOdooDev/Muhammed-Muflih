<odoo>
	<data>
		<record id="view_pos_custom_message" model="ir.ui.view">
			<field name="name">Custom Message</field>
			<field name="model">pos.custom.message</field>
			<field name="arch" type="xml">
				<form string="Point of Sale Custom Message">
					<sheet>
						<group>
							<field name="message_type" />
							<field name="title" />
							<field name="message" />
							<field name="input_time" />
						</group>
						<group>
							<label for="period" string="Time" />
							<div class="o_address_format">
								<div style="float:left;width:38%">
									<field name="hours" placeholder="HH" class="o_address_city" />
									:
									<field name="minutes" placeholder="MM" class="o_address_city" />
								</div>
								<div style="float:left;margin-left:-6%">
									<field name="period" />
								</div>
							</div>
							<field name="point_of_sale_ids" widget="many2many_tags" />
						</group>
					</sheet>
				</form>
			</field>
		</record>
		<record id="tree_view_pos_custom_message" model="ir.ui.view">
			<field name="name">pos.custom.message</field>
			<field name="model">pos.custom.message</field>
			<field name="arch" type="xml">
				<list string="Point of Sale Custom Message">
					<field name="title" />
					<field name="message_type" />
					<field name="input_time" />
				</list>
			</field>
		</record>

		<record id="view_pos_custom_message_form_action" model="ir.actions.act_window">
			<field name="name">Custom Message</field>
			<field name="res_model">pos.custom.message</field>
			<field name="view_mode">list,form</field>
		</record>
        <record id="view_pos_refund_configuration_form" model="ir.ui.view">
            <field name="name">pos.config.form.view.inherited</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id"
                   ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_accounting_section']"
                       position="inside">
					<div class="col-xs-12 col-md-6 o_setting_box" id="custom_message">
						<div class="o_setting_right_pane">
							<label for="pos_custom_message_ids" string="Select Custom Messages" />
							<div class="text-muted">
									Select custom messages that you wish to show in current POS
							</div>
							<div class="content-group mt16">
								<field name="pos_custom_message_ids" widget="many2many_tags" />
							</div>
						</div>
					</div>
				</xpath>
			</field>
		</record>

		<menuitem name="Custom Messages" id="menu_point_of_sale_custom_message" parent="point_of_sale.menu_point_config_product" action="view_pos_custom_message_form_action" sequence="10" />
	</data>
</odoo>