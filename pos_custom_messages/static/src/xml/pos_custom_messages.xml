<templates id="template" xml:space="preserve">

    <t t-name="CustomMessagePopup">
        <Dialog>
            <t t-set-slot="header">
                <div class="modal-header wk-modal-header justify-content-center" style="width: 100%;" t-ref="modalHeader">
                    <i class="message_icon fs-2 me-2" aria-hidden="true" t-ref="message_icon"/>
                    <span class="modal-title fs-2 fw-bolder" id="message_title">
                        <t t-esc="props.title || 'Message' "/>
                    </span>
                </div>
            </t>
            <div class="popup">
                <main class="modal-body">
                    <span id="message_body">
                        <t t-esc="props.body || '' "/>
                    </span>
                </main>
            </div>
        </Dialog>
    </t>
</templates>
