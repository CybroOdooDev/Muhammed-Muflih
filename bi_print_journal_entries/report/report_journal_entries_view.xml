<?xml version="1.0" encoding="utf-8"?>
<!--Journal Entry PDF Report Templates-->
<odoo>
	<!-- QWeb Template: Main Journal Entry Report Content -->
	<template id="journal_entry_template_report_view">
		<t t-call="web.external_layout">
			<t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
			<div class="page">
				<br/>
				<div class="oe_structure"/>
				<div>
					<h2 style="font-size: 22px;" class="text-center mb2">
						<strong>Journal Entry</strong>
					</h2>
				</div>
				<br/>
				<table style="width:100%;margin:0px auto;background:white;border:1px solid #e1e1e1;"
					   class="table table-condensed">
					<tbody>
						<tr>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Journal Entry :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<p style="margin:0; padding: 0;" t-field="o.name"/>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Journal :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<p style="margin:0; padding: 0;" t-field="o.journal_id"/>
							</td>
						</tr>
						<tr>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Date :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<p style="margin:0; padding: 0;" t-field="o.date"/>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Reference :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<p style="margin:0; padding: 0;" t-field="o.ref"/>
							</td>
						</tr>
						<tr>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Name</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;"/>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Cheque Date :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;"/>
						</tr>
						<tr>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Cheque Number :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;"/>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Bank :</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;"/>
						</tr>
					</tbody>
				</table>
				<br/>

				<table style="width:100%;margin:0px auto;background:white;border:1px solid #e1e1e1;"
					   class="table table-condensed">
					<thead>
						<tr style="border:1px solid">
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Partner</th>
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Account</th>
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Label</th>
							<!--						<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Due Date</th>-->
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Analytic
								Account
							</th>
							<!--						<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Taxes(%)</th>-->
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Debit</th>
							<th style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">Credit</th>
						</tr>
					</thead>
					<tbody class="consumed_tbody">
						<t t-set="total" t-value="0.0"/>
						<t t-set="total1" t-value="0.0"/>
						<t t-foreach="o.line_ids" t-as="line">
							<tr style="border:1px solid">
								<td style="margin:0; padding: 0; font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span t-field="line.partner_id"/>
								</td>
								<td style="margin:0; padding: 0; font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span t-field="line.account_id"/>
								</td>
								<td style="margin:0; padding: 0;font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span t-field="line.name"/>
								</td>
								<td style="margin:0; padding: 0;font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span>
										<div t-foreach="line.analytic_distribution" t-as="distribution">
											<t t-esc="line.env['account.analytic.account'].browse(int(distribution))[0].name"/>
											:
											<t t-esc="line.analytic_distribution.get(distribution)"/>
										</div>
									</span>
								</td>
								<td style="margin:0; padding: 0; font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span t-esc="'%.3f' % line.debit"/>
								</td>
								<td style="margin:0; padding: 0; font-weight: 600; font-size: 13px; vertical-align: middle;">
									<span t-esc="'%.3f' % line.credit"/>
								</td>
							</tr>
							<t t-set="total" t-value="total + line.debit"/>
							<t t-set="total1" t-value="total1 + line.credit"/>
						</t>
						<tr>
							<td></td>
							<td></td>
							<td></td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<strong>Total:</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;" width="10%">
								<strong>
									<span>
										<t t-esc="'%.3f' % total"/>
									</span>
								</strong>
							</td>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;" width="10%">
								<strong>
									<span>
										<t t-esc="'%.3f' % total1"/>
									</span>
								</strong>
							</td>
						</tr>
					</tbody>
				</table>
				<table style="width:100%;margin:0px auto;background:white;border:5px 5px solid #e1e1e1;"
					   class="table table-condensed">
					<tbody>
						<tr>
							<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
								<p style="text-transform: capitalize;margin:0; padding: 0;"
								   t-esc="o.state"/>
							</td>
							<td/>
						</tr>
						<tr>
							<td style="font-size: 13px;padding: 20px; vertical-align: middle;">
								<strong>Received By :</strong>
							</td>
							<td style="font-size: 13px;padding: 20px; vertical-align: middle;">
								<strong>Approved By :</strong>
							</td>
						</tr>
						<tr>
						</tr>
						<tr>
							<td style="font-size: 13px;padding: 20px; vertical-align: middle;">
								<strong>Audited By :</strong>
							</td>
							<td style="font-size: 13px; padding: 20px; vertical-align: middle;">
								<strong>Manager :</strong>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</t>
	</template>

	<!-- QWeb Template: Report Wrapper for Journal Entries -->
	<template id="journal_entry_report_template_id">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-call="bi_print_journal_entries.journal_entry_template_report_view" t-lang="o.partner_id.lang"/>
			</t>
		</t>
	</template>

	<!-- QWeb Template Inheritance: Customizes standard external layout footer/header -->
	<template id="external_layout_standard" inherit_id="web.external_layout_standard">
		<xpath expr="//div[hasclass('text-center')]" position="inside">
			<table style="width:100%;margin:0px auto;background:white;border:0px solid #e1e1e1;"
				   class="table table-condensed">
				<tbody>
					<tr t-if="o">
						<t t-set="time_plus" t-value="o.create_date.strptime(o.env.user.tz_offset, '%z')"/>
						<t t-set="time_stamp" t-value="o.create_date.now() + time_plus.utcoffset()"/>
						<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
							<strong>Page:
								<span class="page"/>
								/
								<span class="topage"/>
							</strong>
						</td>
						<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;">
							<strong>Date:
								<span t-esc="time_stamp.strftime('%d/%m/%Y %H:%M:%S')"/>
							</strong>
						</td>
						<td style="margin:0; padding: 0; font-size: 13px; vertical-align: middle;" t-if="user">
							<strong>User:
								<span t-esc="user.name"/>
							</strong>
						</td>
					</tr>
				</tbody>
			</table>
		</xpath>
	</template>
</odoo>