<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_velora_head" inherit_id="website.layout" name="Velora Head Assets">
        <xpath expr="//head" position="inside">
            <meta name="theme-color" content="#0b0b0c"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="preconnect" href="https://images.unsplash.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&amp;family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
        </xpath>
    </template>

    <template id="layout_velora_header" inherit_id="website.layout" name="Velora Header">
        <xpath expr="//header" position="replace">

<t t-set="website_sale_cart_quantity" t-value="request.session['website_sale_cart_quantity'] if 'website_sale_cart_quantity' in request.session else website.sale_get_order().cart_quantity or 0"/>
<t t-set="website_sale_wish_quantity" t-value="len(request.env['product.wishlist'].current())"/>

<!-- Scroll Progress Indicator -->
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<!-- Skip Link for Accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- ============ HEADER / NAVIGATION ============ -->
<header class="site-header" id="siteHeader">
  <nav class="navbar" aria-label="Primary navigation">
    <div class="nav-container">

      <a href="/" class="logo" aria-label="Velora Home">
        <img src="/theme_velora/static/src/img/logo.png" alt="Velora" class="logo-img"/>
      </a>

      <ul class="nav-links" id="navLinks">
        <li><a href="/collections" class="nav-link">Collections</a></li>
        <li><a href="/best-sellers" class="nav-link">Best Sellers</a></li>
        <!-- <li><a href="#categories" class="nav-link">Fragrances</a></li> -->
        <li><a href="/about-us" class="nav-link">Our Story</a></li>
        <!-- <li><a href="#testimonials" class="nav-link">Reviews</a></li> -->
        <li><a href="/contactus" class="nav-link">Contact</a></li>
      </ul>

      <div class="nav-actions">
        <button class="icon-btn" id="searchToggle" aria-label="Open search" aria-expanded="false">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        <a href="/shop/wishlist" class="icon-btn nav-actions-secondary" id="wishlistToggle" aria-label="View wishlist">
          <i class="fa-regular fa-heart"></i>
          <span class="badge js-wishlist-count" id="wishlistCount" t-esc="website_sale_wish_quantity"/>
        </a>
        <button class="icon-btn nav-actions-secondary" id="cartToggle" aria-label="View shopping cart">
          <i class="fa-solid fa-bag-shopping"></i>
          <span class="badge js-cart-count" id="cartCount" t-esc="website_sale_cart_quantity"/>
        </button>
        <button class="icon-btn" aria-label="My account">
          <i class="fa-regular fa-user"></i>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
          <span></span><span></span><span></span>
        </button>
      </div>

    </div>

    <!-- Search Overlay -->
    <div class="search-overlay" id="searchOverlay">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" id="searchInput" placeholder="Search fragrances, brands, notes..." aria-label="Search"/>
        <button class="icon-btn" id="searchClose" aria-label="Close search"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-header">
    <span class="mobile-menu-title">Menu</span>
    <button class="icon-btn" id="mobileMenuClose" aria-label="Close menu">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <ul>
   <li><a href="/collections" class="nav-link">Collections</a></li>
        <li><a href="/best-sellers" class="nav-link">Best Sellers</a></li>
        <!-- <li><a href="#categories" class="nav-link">Fragrances</a></li> -->
        <li><a href="/about-us" class="nav-link">Our Story</a></li>
        <!-- <li><a href="#testimonials" class="nav-link">Reviews</a></li> -->
        <li><a href="/contactus" class="nav-link">Contact</a></li>
  </ul>
  <div class="mobile-menu-actions">
    <a href="/shop/wishlist" class="mobile-menu-action-btn" id="wishlistToggleMobile">
      <i class="fa-regular fa-heart"></i>
      <span>Wishlist</span>
      <span class="badge js-wishlist-count" t-esc="website_sale_wish_quantity"/>
    </a>
    <button class="mobile-menu-action-btn" id="cartToggleMobile">
      <i class="fa-solid fa-bag-shopping"></i>
      <span>Cart</span>
      <span class="badge js-cart-count" t-esc="website_sale_cart_quantity"/>
    </button>
  </div>
</div>

<!-- Cart Drawer -->
<aside class="drawer" id="cartDrawer" aria-label="Shopping cart" aria-hidden="true">
  <div class="drawer-header">
    <h2>Your Bag</h2>
    <button class="icon-btn" id="cartClose" aria-label="Close cart"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="drawer-body" id="cartItems">
    <p class="empty-state">Your bag is empty. Discover a scent worth carrying.</p>
  </div>
  <div class="drawer-footer">
    <div id="cartTotalWrap"/>
    <a href="/shop/checkout" class="btn btn-primary btn-full">Proceed to Checkout</a>
  </div>
</aside>
<div class="drawer-backdrop" id="drawerBackdrop"></div>


        </xpath>
    </template>

    <template id="layout_velora_footer" inherit_id="website.layout" name="Velora Footer">
        <xpath expr="//div[@id='footer']" position="replace">
<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-brand">
      <a href="/" class="logo">
        <img src="/theme_velora/static/src/img/logo.png" alt="Velora" class="logo-img footer-logo-img"/>
      </a>
      <p>Maison de Parfum — crafting timeless fragrances since 1998. Every bottle, a signature.</p>
      <div class="social-links">
        <a href="#" aria-label="Velora on Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" aria-label="Velora on Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#" aria-label="Velora on Pinterest"><i class="fa-brands fa-pinterest-p"></i></a>
        <a href="#" aria-label="Velora on X"><i class="fa-brands fa-x-twitter"></i></a>
      </div>
    </div>

    <nav class="footer-col" aria-label="Collections">
      <h3>Collections</h3>
      <ul>
        <li><a href="/collections">Men's Fragrances</a></li>
        <li><a href="/collections">Women's Fragrances</a></li>
        <li><a href="/collections">Unisex</a></li>
        <li><a href="/collections">Gift Sets</a></li>
        <li><a href="/collections">Limited Editions</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Customer support">
      <h3>Customer Support</h3>
      <ul>
        <li><a href="#">FAQs</a></li>
        <li><a href="/shop">Shipping &amp; Returns</a></li>
        <li><a href="/shop">Track My Order</a></li>
        <li><a href="/shop">Fragrance Guide</a></li>
        <li><a href="/shop">Gift Cards</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h3><a href="/contactus">Contact</a></h3>
      <ul class="contact-list">
        <li><i class="fa-solid fa-location-dot"></i> 12 Rue de la Paix, Paris</li>
        <li><i class="fa-solid fa-phone"></i> +1 (800) 555-0199</li>
        <li><i class="fa-solid fa-envelope"></i> hello@velora.com</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© <span id="year"></span> Velora Parfums. All rights reserved.</p>
    <ul>
      <li><a href="#">Privacy Policy</a></li>
      <li><a href="#">Terms of Service</a></li>
    </ul>
  </div>
</footer>


        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="inside">
<!-- Toast Notification -->
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<!-- Back to Top -->
<button class="back-to-top" id="backToTop" aria-label="Back to top">
  <i class="fa-solid fa-chevron-up"></i>
</button>
        </xpath>
    </template>

    <template id="layout_velora_no_branding" inherit_id="website.layout" name="Velora Hide Branding">
        <xpath expr="//t[@t-call='web.brand_promotion']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
