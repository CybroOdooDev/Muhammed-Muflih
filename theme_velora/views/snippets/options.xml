<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Register Velora snippets into the Website Builder panel.
         Uses the correct Odoo 18 t-snippet / <snippets> format.
    ============================================================ -->
    <template id="velora_snippets_options"
              inherit_id="website.snippets"
              name="Velora Snippets">

        <!-- 1. Register the custom "Velora" category group in the snippets panel -->
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"
               string="Velora"
               snippet-group="velora_snippets"/>
        </xpath>

        <!-- 2. Add Velora snippets to the standard Structure section, assigned to the custom group -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_velora.s_velora_bestsellers_banner"
               string="Bestsellers Banner"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_hero"
               string="Velora Hero"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_velora.s_velora_collections"
               string="Velora Collections"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
            <t t-snippet="theme_velora.s_velora_bestsellers"
               string="Velora Bestsellers"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_catalog.svg"/>
            <t t-snippet="theme_velora.s_velora_categories"
               string="Velora Categories"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
            <t t-snippet="theme_velora.s_velora_about_story"
               string="Velora About Story"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
            <t t-snippet="theme_velora.s_velora_why_us"
               string="Velora Why Us"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_company_team.svg"/>
            <t t-snippet="theme_velora.s_velora_testimonials"
               string="Velora Testimonials"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_blockquote.svg"/>
            <t t-snippet="theme_velora.s_velora_faq"
               string="Velora FAQ"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_accordion.svg"/>
            <t t-snippet="theme_velora.s_velora_newsletter"
               string="Velora Newsletter"
               group="velora_snippets"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_newsletter_subscribe_form.svg"/>
            <t t-snippet="theme_velora.s_velora_contact_banner"
               string="Contact Banner"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_contact_section"
               string="Contact Info &amp; Form"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/img1.jpg"/>
            <t t-snippet="theme_velora.s_velora_contact_map"
               string="Contact Map"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_about_banner"
               string="About Banner"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_about_stats"
               string="About Stats"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/img2.jpg"/>
            <t t-snippet="theme_velora.s_velora_collections_banner"
               string="Collections Banner"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_collections_grid"
               string="Collections Grid"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
            <t t-snippet="theme_velora.s_velora_about_philosophy"
               string="Brand Philosophy"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/img1.jpg"/>
            <t t-snippet="theme_velora.s_velora_confirmation"
               string="Order Confirmation"
               group="velora_snippets"
               t-thumbnail="/theme_velora/static/src/img/hero.webp"/>
        </xpath>

    </template>

</odoo>
