    <!-- ============================================================
         SNIPPET: FAQ ACCORDION
    ============================================================ -->
    <template id="s_velora_snippet_faq" name="Velora FAQ">
        <section class="faq section s_velora o_colored_level" id="faq" data-snippet="theme_velora.s_velora_snippet_faq" data-name="FAQ Accordion">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow o_editable">Need Help?</p>
                    <h2 class="section-title o_editable">Frequently Asked Questions</h2>
                </div>

                <div class="accordion reveal" id="accordion">
                    <div class="accordion-item">
                        <button class="accordion-header" aria-expanded="false">
                            <span>How long does shipping take?</span>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <div class="accordion-panel">
                            <p>Standard delivery takes 3–5 business days. Express shipping (1–2 days) is complimentary on all orders over $150.</p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <button class="accordion-header" aria-expanded="false">
                            <span>Are Velora fragrances cruelty-free?</span>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <div class="accordion-panel">
                            <p>Yes. All Velora products are cruelty-free and never tested on animals, certified by international ethical beauty standards.</p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <button class="accordion-header" aria-expanded="false">
                            <span>Can I return an opened bottle?</span>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <div class="accordion-panel">
                            <p>For hygiene reasons we can only accept returns on unopened, unused bottles within 30 days of delivery in original packaging.</p>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <button class="accordion-header" aria-expanded="false">
                            <span>Do you offer gift wrapping?</span>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <div class="accordion-panel">
                            <p>Absolutely. Add luxury gift wrapping with a hand-tied ribbon and personalised note at checkout for a small fee.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

