    <!-- ============================================================
         SNIPPET: BEST SELLERS
    ============================================================ -->
    <template id="s_velora_snippet_bestsellers" name="Velora Best Sellers">
        <section class="bestsellers section s_velora o_colored_level" id="bestsellers" data-snippet="theme_velora.s_velora_snippet_bestsellers" data-name="Best Sellers">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow o_editable">Adored Worldwide</p>
                    <h2 class="section-title o_editable">Best Sellers</h2>
                    <p class="section-sub o_editable">The fragrances our connoisseurs return to again and again.</p>
                </div>

                <t t-set="velora_products"
                   t-value="request.env['product.template'].sudo().search([('sale_ok', '=', True), ('website_published', '=', True)], limit=8) or request.env['product.template'].sudo().search([('sale_ok', '=', True)], limit=8)"/>
                <div class="product-grid" id="productGrid">
                    <t t-foreach="velora_products" t-as="product">
                        <article class="product-card reveal">
                            <a class="product-media" t-att-href="product.website_url or '/shop/product/%s' % product.id">
                                <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                                     t-att-alt="product.name"
                                     loading="lazy"/>
                            </a>
                            <a href="/shop/wishlist" class="wishlist-btn"
                               t-att-aria-label="'View wishlist for %s' % product.name">
                                <i class="fa-regular fa-heart"></i>
                            </a>
                            <div class="product-info">
                                <span class="product-brand" t-esc="product.categ_id.name or 'Product'"/>
                                <a t-att-href="product.website_url or '/shop/product/%s' % product.id">
                                    <h3 class="product-name" t-esc="product.name"/>
                                </a>
                                <p class="product-desc" t-esc="product.description_sale or product.public_categ_ids[:1].name or product.categ_id.name or ''"/>
                                <div class="product-price-row">
                                    <div class="price-group">
                                        <span class="price-current"
                                              t-field="product.list_price"
                                              t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                    </div>
                                    <form action="/shop/cart/update" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>
                                        <input type="hidden" name="add_qty" value="1"/>
                                        <button type="submit" class="add-cart-btn"
                                                t-att-aria-label="'Add %s to cart' % product.name">
                                            <i class="fa-solid fa-bag-shopping"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </t>
                    <div t-if="not velora_products" class="empty-state">No products are available.</div>
                </div>
            </div>
        </section>
    </template>

