<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SNIPPET: HERO BANNER
    ============================================================ -->
    <template id="s_velora_snippet_hero" name="Velora Hero Banner">
        <section class="hero s_velora o_colored_level" id="hero" data-snippet="theme_velora.s_velora_snippet_hero" data-name="Hero Banner">
            <div class="hero-bg">
                <img src="/theme_velora/static/src/img/hero.webp"
                     alt="Velora signature perfume bottle on marble surface with golden light"
                     class="o_we_custom_image"
                     loading="eager"/>
                <div class="hero-overlay"></div>
            </div>

            <div class="hero-text-top">
                <h1 class="hero-title">
                    <span class="title-line reveal o_editable">Discover Your</span><br/>
                    <em class="title-line title-line-gold reveal o_editable">Signature <br/>Scent</em>
                </h1>
            </div>

            <div class="hero-text-bottom">
                <p class="hero-desc reveal o_editable">Exquisitely crafted fragrances born from rare botanicals and precious woods — an olfactory journey designed for those who leave a lasting impression.</p>
                <div class="hero-actions reveal">
                    <a href="/shop" class="btn btn-primary o_editable">
                        <span>Shop Best Sellers</span>
                    </a>
                    <a href="/about-us" class="btn btn-outline-light o_editable">
                        <span>Explore Our Story</span>
                    </a>
                </div>
            </div>
        </section>
    </template>

