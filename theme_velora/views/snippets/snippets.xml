    <!-- ============================================================
         SNIPPET 2: CONTACT INFO + FORM (2-column layout)
         Left: info list + socials | Right: contact form
    ============================================================ -->
    <template id="s_velora_contact_section" name="Velora Contact Section">
        <section class="vc-contact-section section s_velora o_colored_level"
                 data-snippet="theme_velora.s_velora_contact_section"
                 data-name="Contact Info &amp; Form">
            <div class="container vc-contact-grid">

                <!-- LEFT: Contact Info -->
                <div class="vc-info reveal">
                    <p class="eyebrow o_editable">Get In Touch</p>
                    <h2 class="section-title o_editable">Visit, Call, Or Write</h2>
                    <p class="section-sub o_editable">Our concierge team is available to help you discover your signature scent, track an order, or arrange a private fragrance consultation.</p>

                    <ul class="vc-info-list">
                        <li>
                            <span class="vc-info-icon"><i class="fa fa-map-marker"></i></span>
                            <div>
                                <strong class="o_editable">Boutique Address</strong>
                                <span class="o_editable">12 Rue de la Paix, 75002 Paris, France</span>
                            </div>
                        </li>
                        <li>
                            <span class="vc-info-icon"><i class="fa fa-phone"></i></span>
                            <div>
                                <strong class="o_editable">Phone</strong>
                                <span><a href="tel:+18005550199" class="o_editable">+1 (800) 555-0199</a></span>
                            </div>
                        </li>
                        <li>
                            <span class="vc-info-icon"><i class="fa fa-envelope"></i></span>
                            <div>
                                <strong class="o_editable">Email</strong>
                                <span><a href="mailto:hello@velora.com" class="o_editable">hello@velora.com</a></span>
                            </div>
                        </li>
                        <li>
                            <span class="vc-info-icon"><i class="fa fa-clock-o"></i></span>
                            <div>
                                <strong class="o_editable">Boutique Hours</strong>
                                <span class="o_editable">Mon – Sat, 10:00 – 19:00 CET</span>
                            </div>
                        </li>
                    </ul>

                    <div class="vc-socials">
                        <a href="#" aria-label="Velora on Instagram"><i class="fa fa-instagram"></i></a>
                        <a href="#" aria-label="Velora on Facebook"><i class="fa fa-facebook-f"></i></a>
                        <a href="#" aria-label="Velora on Pinterest"><i class="fa fa-pinterest-p"></i></a>
                        <a href="#" aria-label="Velora on X"><i class="fa fa-twitter"></i></a>
                    </div>
                </div>

                <!-- RIGHT: Contact Form -->
                <div class="vc-form-wrap reveal">
                    <p class="eyebrow o_editable">Send A Message</p>
                    <h2 class="section-title o_editable">Start A Conversation</h2>

                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                        <div class="container p-0">
                            <form id="contactus_form"
                                  action="/website/form/"
                                  method="post"
                                  enctype="multipart/form-data"
                                  class="o_mark_required vc-form"
                                  data-mark="*"
                                  data-model_name="mail.mail"
                                  data-success-mode="redirect"
                                  data-success-page="/contactus-thank-you"
                                  data-pre-fill="true">

                                <div class="s_website_form_rows row s_col_no_bgcolor g-3">

                                    <div class="col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
                                         data-type="char" data-name="Field">
                                        <label class="vc-label" for="vc_name">Full Name</label>
                                        <input id="vc_name" type="text"
                                               class="form-control vc-input s_website_form_input"
                                               name="name" placeholder="Your name"
                                               required="" data-fill-with="name"/>
                                    </div>

                                    <div class="col-md-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                         data-type="email" data-name="Field">
                                        <label class="vc-label" for="vc_email">Email Address</label>
                                        <input id="vc_email" type="email"
                                               class="form-control vc-input s_website_form_input"
                                               name="email_from" placeholder="you@example.com"
                                               required="" data-fill-with="email"/>
                                    </div>

                                    <div class="col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                         data-type="char" data-name="Field">
                                        <label class="vc-label" for="vc_subject">Subject</label>
                                        <input id="vc_subject" type="text"
                                               class="form-control vc-input s_website_form_input"
                                               name="subject" placeholder="How can we help?" required=""/>
                                    </div>

                                    <div class="col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                         data-type="text" data-name="Field">
                                        <label class="vc-label" for="vc_message">Message</label>
                                        <textarea id="vc_message"
                                                  class="form-control vc-input s_website_form_input"
                                                  name="description"
                                                  placeholder="Tell us a little more..."
                                                  required="" rows="5"></textarea>
                                    </div>

                                    <!-- Hidden email_to -->
                                    <div class="col-12 s_website_form_field s_website_form_dnone">
                                        <input type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                    </div>

                                    <!-- Submit -->
                                    <div class="col-12 s_website_form_submit" data-name="Submit Button">
                                        <a href="#" role="button"
                                           class="btn vc-btn-submit s_website_form_send o_editable">
                                            <span>Send Message</span>
                                        </a>
                                        <span id="s_website_form_result"></span>
                                    </div>

                                </div>
                            </form>
                        </div>
                    </section>
                </div>

            </div>
        </section>
