<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         VELORA CONTACT PAGE
         Inherits website.contactus and replaces the #wrap with:
           Snippet 1: s_velora_contact_banner  – hero / page banner
           Snippet 2: s_velora_contact_section – info + form (2 cols)
           Snippet 3: s_velora_contact_map     – full-width map
         All three are pre-rendered via t-snippet-call so they are
         visible to visitors by default, and also draggable/editable
         in the Website Builder.
    ============================================================ -->
    <template id="velora_contactus"
              name="Velora Contact Us"
              inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Snippet 1: Page Banner -->
                <section class="page-banner s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_contact_banner"
                         data-name="Contact Banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            <span>We'd Love To Hear From You</span>
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            Get In <em>Touch</em>
                        </h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Contact</span>
                        </nav>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 2: Contact Info + Form -->
                <section class="contact-section section s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_contact_section"
                         data-name="Contact Info &amp; Form">
                    <div class="container contact-grid">
                        <!-- LEFT: Contact Info -->
                        <div class="contact-info">
                            <p class="eyebrow">Get In Touch</p>
                            <h2 class="section-title">Visit, Call, Or Write</h2>
                            <p class="section-sub">Our concierge team is available to help you discover your signature scent, track an order, or arrange a private fragrance consultation.</p>

                            <ul class="contact-info-list">
                                <li>
                                    <span class="contact-info-icon"><i class="fa-solid fa-location-dot"></i></span>
                                    <div>
                                        <strong>Boutique Address</strong>
                                        <span>12 Rue de la Paix, 75002 Paris, France</span>
                                    </div>
                                </li>
                                <li>
                                    <span class="contact-info-icon"><i class="fa-solid fa-phone"></i></span>
                                    <div>
                                        <strong>Phone</strong>
                                        <span><a href="tel:+18005550199">+1 (800) 555-0199</a></span>
                                    </div>
                                </li>
                                <li>
                                    <span class="contact-info-icon"><i class="fa-solid fa-envelope"></i></span>
                                    <div>
                                        <strong>Email</strong>
                                        <span><a href="mailto:hello@velora.com">hello@velora.com</a></span>
                                    </div>
                                </li>
                                <li>
                                    <span class="contact-info-icon"><i class="fa-regular fa-clock"></i></span>
                                    <div>
                                        <strong>Boutique Hours</strong>
                                        <span>Mon &#8211; Sat, 10:00 &#8211; 19:00 CET</span>
                                    </div>
                                </li>
                            </ul>

                            <div class="social-links contact-social">
                                <a href="#" aria-label="Velora on Instagram"><i class="fa-brands fa-instagram"></i></a>
                                <a href="#" aria-label="Velora on Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                <a href="#" aria-label="Velora on Pinterest"><i class="fa-brands fa-pinterest-p"></i></a>
                                <a href="#" aria-label="Velora on X"><i class="fa-brands fa-x-twitter"></i></a>
                            </div>
                        </div>

                        <!-- RIGHT: Contact Form -->
                        <div class="contact-form">
                            <p class="eyebrow">Send A Message</p>
                            <h2 class="section-title">Start A Conversation</h2>

                            <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                <div class="container p-0">
                                    <form id="contactus_form"
                                          action="/website/form/"
                                          method="post"
                                          enctype="multipart/form-data"
                                          class="o_mark_required"
                                          data-mark="*"
                                          data-model_name="mail.mail"
                                          data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you"
                                          data-pre-fill="true">

                                        <div class="s_website_form_rows row s_col_no_bgcolor g-3">

                                            <div class="col-md-6 s_website_form_field s_website_form_custom s_website_form_required form-field"
                                                 data-type="char" data-name="Field">
                                                <label for="vc_name">Full Name</label>
                                                <input id="vc_name" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="name" placeholder="Your name"
                                                       required="" data-fill-with="name"/>
                                            </div>

                                            <div class="col-md-6 s_website_form_field s_website_form_required s_website_form_model_required form-field"
                                                 data-type="email" data-name="Field">
                                                <label for="vc_email">Email Address</label>
                                                <input id="vc_email" type="email"
                                                       class="form-control s_website_form_input"
                                                       name="email_from" placeholder="you@example.com"
                                                       required="" data-fill-with="email"/>
                                            </div>

                                            <div class="col-12 s_website_form_field s_website_form_required s_website_form_model_required form-field"
                                                 data-type="char" data-name="Field">
                                                <label for="vc_subject">Subject</label>
                                                <input id="vc_subject" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="subject" placeholder="How can we help?" required=""/>
                                            </div>

                                            <div class="col-12 s_website_form_field s_website_form_custom s_website_form_required form-field"
                                                 data-type="text" data-name="Field">
                                                <label for="vc_message">Message</label>
                                                <textarea id="vc_message"
                                                          class="form-control s_website_form_input"
                                                          name="description"
                                                          placeholder="Tell us a little more..."
                                                          required="" rows="5"></textarea>
                                            </div>

                                            <!-- Hidden email_to -->
                                            <div class="col-12 s_website_form_field s_website_form_dnone">
                                                <input type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                            </div>

                                            <!-- Submit -->
                                            <div class="col-12 s_website_form_submit" data-name="Submit Button">
                                                <a href="#" role="button"
                                                   class="btn btn-primary btn-full s_website_form_send">
                                                    <span>Send Message</span>
                                                </a>
                                                <span id="s_website_form_result"></span>
                                            </div>

                                        </div>
                                    </form>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 3: Map -->
                <section class="map-section s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_contact_map"
                         data-name="Contact Map">
                    <div class="map-frame">
                        <iframe
                            title="Velora boutique location on map"
                            src="https://maps.google.com/maps?q=12%20Rue%20de%20la%20Paix%2C%20Paris&amp;t=&amp;z=14&amp;ie=UTF8&amp;iwloc=&amp;output=embed"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>

</odoo>
