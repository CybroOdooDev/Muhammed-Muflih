<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_velora_bestsellers" name="Best Sellers">
        <t t-call="website.layout">
            <t t-set="additional_title">Best Sellers</t>
            <div id="wrap" class="oe_structure oe_empty">

                <!-- ============ PAGE BANNER ============ -->
                <section class="page-banner s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_bestsellers_banner"
                         data-name="Bestsellers Banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            Chosen by Connoisseurs
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            Our Bestselling <em>Fragrances</em>
                        </h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Best Sellers</span>
                        </nav>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- ============ BEST SELLERS INTRO ============ -->
                <section class="bestsellers section s_velora_bestsellers o_colored_level" id="bestsellers"
                         data-snippet="theme_velora.s_velora_bestsellers"
                         data-name="Velora Bestsellers">
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">Adored Worldwide</p>
                            <h2 class="section-title">Best Sellers</h2>
                            <p class="section-sub">The fragrances our connoisseurs return to again and again.</p>
                        </div>

                        <!-- Dynamic product grid from Odoo (limit 3) -->
                        <div class="product-grid">
                            <t t-set="products" t-value="request.env['product.template'].sudo().search([('website_published', '=', True), ('sale_ok', '=', True)], limit=3, order='create_date desc')"/>
                            <t t-foreach="products" t-as="product">
                                <article class="product-card reveal">
                                    <div class="product-media">
                                        <t t-set="ribbon" t-value="product.website_ribbon_id"/>
                                        <span class="discount-badge" t-if="ribbon" t-out="ribbon.name"/>
                                        <button class="wishlist-btn" aria-label="Add to wishlist"><i class="fa-regular fa-heart"></i></button>
                                        <a t-attf-href="/shop/#{product.id}">
                                            <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                                                 t-att-alt="product.name" loading="lazy"/>
                                        </a>
                                    </div>
                                    <div class="product-info">
                                        <span class="product-brand">Velora Maison</span>
                                        <h3 class="product-name">
                                            <a t-attf-href="/shop/#{product.id}" t-field="product.name"/>
                                        </h3>
                                        <p class="product-desc" t-if="product.description_sale" t-field="product.description_sale"/>
                                        <!--<p class="product-desc">A luxurious fragrance crafted with the finest ingredients.</p>-->

                                        <!--<div class="product-rating">
                                            <span aria-hidden="true" style="color:var(&#45;&#45;color-gold)">
                                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i>
                                            </span>
                                            <span>4.8 (97)</span>
                                        </div>-->A luxurious fragrance crafted with the finest ingredients.

                                        <div class="product-price-row">
                                            <div class="price-group">
                                                <span class="price-current" t-field="product.list_price"
                                                      t-options="{'widget': 'monetary', 'display_currency': request.env.company.currency_id}"/>
                                            </div>
                                            <button class="add-cart-btn btn-full-text" t-att-data-product-id="product.product_variant_id.id" t-att-data-template-id="product.id" t-attf-aria-label="Add #{product.name} to cart">
                                                ADD TO CART
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            </t>

                            <!-- Fallback if no products -->
                            <t t-if="not products">
                                <div class="no-products-message" style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
                                    <i class="fa-solid fa-gem" style="font-size: 3rem; color: #c8a55a; margin-bottom: 20px;"></i>
                                    <h3 style="font-family: 'Playfair Display', serif; color: #111; margin-bottom: 15px;">Coming Soon</h3>
                                    <p style="color: #666;">Our bestselling fragrances are being curated. Check back soon.</p>
                                    <a href="/shop" class="btn btn-primary" style="margin-top: 20px;">Browse All Fragrances</a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

            </div>
        </t>
    </template>

    <record id="page_bestsellers_theme" model="theme.website.page">
        <field name="url">/bestsellers</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="theme_velora_bestsellers"/>
    </record>
</odoo>
