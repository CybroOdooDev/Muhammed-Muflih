<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="collections_page" name="Velora Collections">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Snippet 1: Collections Banner -->
                <section class="page-banner s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_collections_banner"
                         data-name="Collections Banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal"><span class="hero-eyebrow-line"></span><span>Crafted for Every Occasion</span><span class="hero-eyebrow-line"></span></p>
                        <h1 class="page-banner-title hero-title reveal">Our latest <em>Collections</em></h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Collections</span>
                        </nav>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 2: Collections Grid -->
                <section class="collections-page-section s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_collections_grid"
                         data-name="Collections Grid">
                    <div class="container">
                        <div class="section-header reveal">
                            <p class="eyebrow">Signature Collection</p>
                            <h2 class="section-title">Explore Every Fragrance Story</h2>
                            <p class="section-sub">
                                Every perfume is carefully crafted to express elegance, confidence,
                                and individuality. Discover timeless scents inspired by nature,
                                luxury, and unforgettable moments.
                            </p>
                        </div>

                        <div class="collections-page-grid">
                            <article class="collections-page-card reveal">
                                <div class="collections-page-image">
                                    <img src="/theme_velora/static/src/img/men.jpg" alt="Men's Fragrance Collection" loading="lazy" class="o_we_custom_image"/>
                                </div>
                                <div class="collections-page-content">
                                    <span>01</span>
                                    <h3>Men's Collection</h3>
                                    <p>
                                        Rich woody accords blended with leather, amber and fresh citrus
                                        for the modern gentleman.
                                    </p>
                                    <a href="/collections/mens_collection" class="btn-outline">
                                        Explore Collection
                                    </a>
                                </div>
                            </article>

                            <article class="collections-page-card reveal reverse">
                                <div class="collections-page-image">
                                    <img src="/theme_velora/static/src/img/women.jpg" alt="Women's Fragrance Collection" loading="lazy" class="o_we_custom_image"/>
                                </div>
                                <div class="collections-page-content">
                                    <span>02</span>
                                    <h3>Women's Collection</h3>
                                    <p>
                                        Elegant floral compositions with jasmine, rose and vanilla,
                                        created for timeless sophistication.
                                    </p>
                                    <a href="/collections/womens_collection" class="btn-outline">
                                        Explore Collection
                                    </a>
                                </div>
                            </article>

                            <article class="collections-page-card reveal">
                                <div class="collections-page-image">
                                    <img src="/theme_velora/static/src/img/unisex.jpeg" alt="Unisex Fragrance Collection" loading="lazy" class="o_we_custom_image"/>
                                </div>
                                <div class="collections-page-content">
                                    <span>03</span>
                                    <h3>Unisex Collection</h3>
                                    <p>
                                        Modern fragrances balancing freshness, woods and musk for
                                        effortless everyday luxury.
                                    </p>
                                    <a href="/collections/unisex" class="btn-outline">
                                        Explore Collection
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>

    <data noupdate="1">
        <!-- Website Page for Collections -->
        <record id="website_page_collections" model="theme.website.page">
            <field name="url">/collections</field>
            <field name="view_id" ref="collections_page"/>
            <field name="is_published">True</field>
        </record>
    </data>

</odoo>
