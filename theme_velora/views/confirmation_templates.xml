<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Order Confirmation Page -->
    <template id="theme_velora_confirmation" inherit_id="website_sale.confirmation" name="Theme Velora Confirmation">
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="replace">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- Snippet: Order Confirmation -->
                    <section class="page-banner s_velora s_velora_confirmation o_colored_level"
                             data-snippet="theme_velora.s_velora_confirmation"
                             data-name="Velora Confirmation">
                        <div class="page-banner-bg"></div>
                        <div class="page-banner-content container">
                            <div class="confirmation-icon reveal">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                            <h1 class="page-banner-title hero-title reveal">
                                Order <em>Confirmed</em>
                            </h1>
                            <p class="confirmation-desc reveal">
                                Thank you for your purchase! Your bill has been paid and your order is now being processed. We will send you an email confirmation shortly.
                            </p>
                            <div class="reveal">
                                <a href="/shop" class="btn btn-gold">
                                    <span>Continue Shopping</span>
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
