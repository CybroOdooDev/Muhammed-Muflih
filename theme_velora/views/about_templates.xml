<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         VELORA ABOUT / OUR STORY PAGE
         Inherits website.aboutus and replaces the #wrap with the
         4 new snippets. All four are pre-rendered via t-snippet-call.
    ============================================================ -->
    <template id="velora_aboutus"
              name="Velora About Us"
              inherit_id="website.aboutus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Snippet 1: About Banner -->
                <section class="page-banner s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_about_banner"
                         data-name="About Banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            <span>Maison de Parfum</span>
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            Our <em>Story</em>
                        </h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">About</span>
                        </nav>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 2: About Story Detail -->
                <section class="about-story section s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_about_story"
                         data-name="About Story Detail">
                    <div class="container">
                        <div class="row align-items-center about-story-grid">
                            <!-- Left Image -->
                            <div class="col-lg-6">
                                <div class="about-image">
                                    <img src="/theme_velora/static/src/img/men.jpg"
                                         alt="Velora Perfume"
                                         class="img-fluid o_we_custom_image"
                                         loading="lazy"/>
                                </div>
                            </div>

                            <!-- Right Content -->
                            <div class="col-lg-6">
                                <div class="about-content">
                                    <p class="eyebrow">Maison Velora</p>

                                    <h2 class="section-title">
                                        Where Every <br/>
                                        Fragrance Tells A <br/>
                                        Story
                                    </h2>

                                    <p class="section-sub">
                                        Founded with a passion for fine perfumery, Velora believes that fragrance is more than a scent—it is an expression of identity, emotion, and timeless elegance.
                                    </p>

                                    <p>
                                        Every bottle is thoughtfully crafted using exceptional ingredients, refined artistry, and meticulous attention to detail. From delicate florals to rich woody accords, our collections celebrate the beauty of individuality and the memories that fragrances create.
                                    </p>

                                    <a href="/shop" class="btn btn-primary">
                                        Explore Collection
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 3: About Stats -->
                <section class="about-stats s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_about_stats"
                         data-name="About Stats">
                    <div class="container">
                        <div class="row justify-content-center border-top border-bottom border-white border-opacity-25 py-5">
                            <div class="col-lg-3 col-md-6">
                                <div class="stat reveal">
                                    <h2>28+</h2>
                                    <span>Years of Excellence</span>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="stat reveal">
                                    <h2>150+</h2>
                                    <span>Luxury Fragrances</span>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="stat reveal">
                                    <h2>40+</h2>
                                    <span>Countries Served</span>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="stat reveal">
                                    <h2>250K+</h2>
                                    <span>Happy Customers</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Snippet 4: Brand Philosophy -->
                <section class="brand-philosophy section s_velora o_colored_level"
                         data-snippet="theme_velora.s_velora_about_philosophy"
                         data-name="Brand Philosophy">
                    <div class="container">
                        <div class="section-header reveal">
                            <p class="eyebrow">Our Philosophy</p>
                            <h2 class="section-title">Luxury Crafted With Purpose</h2>
                            <p class="section-sub">
                                Every fragrance is created to inspire confidence,
                                elegance and unforgettable memories.
                            </p>
                        </div>
                        <div class="philosophy-grid">
                            <div class="philosophy-card reveal">
                                <i class="fa-solid fa-gem"></i>
                                <h3>Timeless Elegance</h3>
                                <p>We design fragrances that transcend trends and become lifelong signatures.</p>
                            </div>
                            <div class="philosophy-card reveal">
                                <i class="fa-solid fa-leaf"></i>
                                <h3>Natural Ingredients</h3>
                                <p>Every perfume begins with carefully selected botanicals, rare woods and luxurious oils.</p>
                            </div>
                            <div class="philosophy-card reveal">
                                <i class="fa-solid fa-award"></i>
                                <h3>Exceptional Craftsmanship</h3>
                                <p>Master perfumers combine tradition and innovation to create fragrances with lasting character.</p>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>

    <data noupdate="1">
        <!-- Website Page for About Us -->
        <record id="website_page_about_us" model="website.page">
            <field name="url">/about-us</field>
            <field name="view_id" ref="website.aboutus"/>
            <field name="is_published">True</field>
            <field name="track">True</field>
            <field name="website_meta_description">About Velora - Our Story</field>
        </record>
    </data>


</odoo>
