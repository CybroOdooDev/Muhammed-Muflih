<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Website Login Layout to match Velora Page Banner & Card Design -->
    <template id="velora_login_layout" inherit_id="website.login_layout" name="Velora Login Layout" priority="30">
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="replace">
            <main id="main-content">
                <section class="page-banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <h1 class="page-banner-title hero-title reveal">
                            Welcome <em>Back</em>
                        </h1>
                    </div>
                </section>

                <section class="section">
                    <div class="container" style="max-width: 600px; margin: 0 auto;">
                        <div class="contact-form reveal">
                            <div class="section-head" style="margin-bottom: 2rem;">
                                <h2 class="section-title" style="font-size: 2rem;">Sign In</h2>
                                <p>Enter your email and password to access your account.</p>
                            </div>
                            <t t-out="0"/>
                        </div>
                    </div>
                </section>
            </main>
        </xpath>
    </template>

    <!-- Override Web Login Form Controls to match Velora Design -->
    <template id="velora_login" inherit_id="web.login" name="Velora Login Form">
        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">oe_login_form form-wrapper #{'' if login else 'd-none'}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class">form-field field-login</attribute>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]/label" position="replace">
            <label for="login">Email Address</label>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]/input" position="attributes">
            <attribute name="placeholder">hello@example.com</attribute>
        </xpath>
        <xpath expr="//label[@for='password']/parent::div" position="attributes">
            <attribute name="class">form-field field-password</attribute>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password">Password</label>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">••••••••</attribute>
        </xpath>
        <xpath expr="//button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary btn-full" style="margin-top: 1rem;">
                <span>Sign In</span>
            </button>
        </xpath>
    </template>

    <!-- Refine Signup & Password Reset Links from auth_signup if present -->
    <template id="velora_auth_signup_login" inherit_id="auth_signup.login" name="Velora Auth Signup Login Links">
        <xpath expr="//label[@for='password']/a[@t-if='reset_password_enabled']" position="replace"/>
        <xpath expr="//input[@id='password']" position="after">
            <div class="d-flex justify-content-end align-items-center mt-1 password-actions">
                <a t-if="reset_password_enabled" class="velora-auth-link" tabindex="1" t-attf-href="/web/reset_password?{{ keep_query() }}">Reset Password</a>
            </div>
        </xpath>
        <xpath expr="//p[hasclass('mt-2')]" position="replace">
            <p style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--color-text-soft);">
                Don't have an account? <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}" class="velora-auth-link" style="font-weight: 500;">Create one</a>
            </p>
        </xpath>
    </template>
</odoo>
