<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Traceability list: where material was received from and where it went
         (Vendor -> Quarantine -> Released/Rejected), opened from the QC Test
         Order and the Quarantine Queue. -->
    <record id="view_pharma_move_line_list" model="ir.ui.view">
        <field name="name">pharma.stock.move.line.trace.list</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <list string="Stock Moves" create="0" delete="0" edit="0" default_order="date desc">
                <field name="date" string="Date"/>
                <field name="reference" string="Reference"/>
                <field name="product_id"/>
                <field name="lot_id" string="Lot / Batch"
                       groups="stock.group_production_lot"/>
                <field name="location_id" string="From"/>
                <field name="location_dest_id" string="To"/>
                <field name="quantity" string="Quantity"/>
                <field name="product_uom_id" string="UoM" groups="uom.group_uom"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>
</odoo>
