<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherit product template to add auction -->
    <record id="product_template_only_form_view_inherit_website_bargain" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.website.bargain</field>
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//field[@name='description_sale']"
                   position="after">
                <field name="is_auction"/>
            </xpath>
        </field>
    </record>
</odoo>


