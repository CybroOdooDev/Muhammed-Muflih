<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting the config setting and add the values for printer-->
    <record id="res_config_settings_view_form_inherit_pos_direct_kitchen_print" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.direct.kitchen.print</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id"
               ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Direct Print" string="Pos Kitchen Direct Print"
                     name="pos_direct_kitchen_print">
                    <block title="Pos Kitchen Direct Print"
                           name="pos_direct_kitchen_print_setting_container">
                        <setting id="api_control_setting"
                                 help="Define your PrintNode API Key"
                                 title="API Key" string="API Key">
                            <div class="content-group" name="api_key_options">
                                <div class="d-flex">
                                    <field name="api_key_print_node" password="1"
                                           class="ms-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="available_printer_setting"
                                 help="Check and select available PrintNode printers for kitchen orders."
                                 string="Available Printers"
                                 title="Available Printers">
                            <div class="content-group" name="api_key_options">
                                <field name="available_printers_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       help='Available printers'/>
                                <div class="mt-2">
                                    <button name="action_check_printers"
                                            string="Check available printers"
                                            type="object" class="btn-primary"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
