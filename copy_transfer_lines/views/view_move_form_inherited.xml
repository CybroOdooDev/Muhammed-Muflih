<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<!--inherited the account.move model and added the field move_type_id -->
    <record id="account_view_move_form" model="ir.ui.view">
        	<field name="name">account.move.account.view_move_.form.inherit</field>
        	<field name="model">account.move</field>
        	<field name="inherit_id" ref="account.view_move_form"/>
        	<field name="arch" type="xml">
				<xpath expr="//header" position="inside">
					<button type="object" name="action_assign_transfer_line" string="Assign Transfer" invisible="not transfer_type_id"/>
				</xpath>
            	<xpath expr="//field[@name='ref']" position="after">
                		<field name="transfer_type_id" string="Copy From" invisible="move_type not in ('in_invoice', 'out_invoice', 'out_refund', 'in_refund')"
							   readonly="state in ['posted']"/>
				</xpath>
        	</field>
    </record>
</odoo>